{% extends 'base.html.twig' %}
{% block title %}Planning — WeCare Admin{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('assets/admin/css/planning.css') }}">
{% endblock %}

{% block body %}
{% include 'admin/_sidebar.html.twig' %}

<div class="page-content">
  {% for msg in app.flashes('error') %}
  <div style="background:#fee2e2;color:#991b1b;padding:10px 28px;font-size:12px;font-weight:600;display:flex;align-items:center;gap:8px;flex-shrink:0;">
    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><circle cx="12" cy="16" r=".5" fill="currentColor"/></svg>
    {{ msg }}
  </div>
  {% endfor %}

  <div class="topbar">
    <span class="topbar-title">Planning</span>

    <div class="date-nav">
      <a href="{{ path('admin_planning', {date: prevDate}) }}" class="date-nav-btn">&#8249;</a>
      <span class="date-nav-label">{{ dateLabel }}</span>
      <a href="{{ path('admin_planning', {date: nextDate}) }}" class="date-nav-btn">&#8250;</a>
    </div>

    <a href="{{ path('admin_planning') }}" class="btn-today {{ isToday ? 'btn-today--active' : '' }}">Aujourd'hui</a>

    {% if nbInterventions > 0 %}
    <span class="nb-badge">{{ nbInterventions }} intervention{{ nbInterventions > 1 ? 's' : '' }}</span>
    {% endif %}

    <div class="add-wrap" style="margin-left:auto;">
      <div style="display:flex;">
        <button class="btn-add-main" onclick="openInterventionModal()">
          <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Ajouter
        </button>
        <button class="btn-add-arrow" id="addToggle">
          <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
      </div>
      <div class="add-dropdown" id="addDropdown">
        <div class="add-dropdown-section">Créer</div>
        <div class="add-dropdown-item" onclick="openInterventionModal()">Intervention patient</div>
        <div class="add-dropdown-item" onclick="openInterventionModal()">Soins infirmiers</div>
        <div class="add-dropdown-item" onclick="openInterventionModal()">Aide à domicile</div>
      </div>
    </div>
  </div>

  {% if tachesACouvrir|length > 0 %}
  <div class="a-couvrir-bar">
    <span class="a-couvrir-title">⚠ À couvrir ({{ tachesACouvrir|length }}) —</span>
    {% for t in tachesACouvrir %}
    <span class="a-couvrir-chip" onclick="openReassignModal({{ t.id }}, '{{ t.patient|e('js') }}', '{{ t.hDebutF }}', '{{ t.hFinF }}', 0)"
          title="Cliquer pour assigner un soignant">
      {{ t.patient }}
      <span class="chip-h">{{ t.hDebutF }}–{{ t.hFinF }}</span>
      <span class="chip-type">{{ t.type }}</span>
    </span>
    {% endfor %}
  </div>
  {% endif %}

  <div class="planning-body">

    <!-- Sidebar filtre soignants -->
    <div class="plan-sidebar">
      {% for secteurName, ivs in secteurs %}
      {% if ivs|length > 0 %}
      <div class="sidebar-section-title">{{ secteurName }}</div>
      {% for iv in ivs %}
      <div class="sidebar-item">
        <input type="checkbox" id="cb-iv-{{ iv.id }}" checked
               class="iv-checkbox" data-iv="{{ iv.id }}">
        <div class="iv-dot" style="background: {{ iv.color }}"></div>
        <label for="cb-iv-{{ iv.id }}">{{ iv.prenom }}</label>
      </div>
      {% endfor %}
      {% endif %}
      {% endfor %}
    </div>

    <!-- Grille du jour -->
    <div class="plan-main">
      <div class="cal-scroll">
        {% if intervenants|length == 0 %}
        <div style="padding:48px;text-align:center;color:#d1d5db;font-size:13px;">
          Aucun soignant enregistré.
          <a href="{{ path('admin_soignants') }}" style="color:var(--pink);font-weight:600;">Ajouter des soignants →</a>
        </div>
        {% else %}
        <table class="cal-table">
          <thead>
            <tr>
              <th class="time-th"></th>
              {% for iv in intervenants %}
              <th class="iv-th" data-iv="{{ iv.id }}">
                <div class="iv-th-inner">
                  <div class="av-circle" style="background: {{ iv.color }}">{{ iv.initiales }}</div>
                  <div class="av-name">{{ iv.nom }}</div>
                  <div class="av-spe">{{ iv.specialite }}</div>
                  {% if not iv.disponible %}
                  {% set sl = {'conge':'En congé','arret':'Arrêt maladie','formation':'En formation','indisponible':'Indisponible'} %}
                  <div class="av-indispo">{{ sl[iv.statut] ?? 'Indisponible' }}</div>
                  {% endif %}
                </div>
              </th>
              {% endfor %}
            </tr>
          </thead>
          <tbody>
            {% for heure in heures %}
            <tr>
              <td class="time-cell">{{ '%02d'|format(heure) }}h</td>
              {% for iv in intervenants %}
              <td class="event-cell" data-iv="{{ iv.id }}"
                  onclick="openInterventionModal('{{ date }}', {{ iv.id }}, {{ heure }})">
                {% set blocs = (grid[iv.id] is defined and grid[iv.id][heure] is defined) ? grid[iv.id][heure] : [] %}
                {% if blocs|length == 0 %}
                  <div class="empty-hour">+</div>
                {% endif %}
                {% for bloc in blocs %}
                <div class="cal-block {{ not iv.disponible ? 'indispo' : '' }}"
                     style="{{ iv.disponible ? 'background:' ~ iv.color : '' }}"
                     onclick="event.stopPropagation()">
                  {% if not iv.disponible %}<span class="b-warn">⚠ {{ iv.nom }}</span>{% endif %}
                  <span class="b-name">{{ bloc.patient }}</span>
                  <span class="b-time">{{ bloc.hdebut }}–{{ bloc.hfin }}</span>
                  <span class="b-type">{{ bloc.type }}</span>
                  <button type="button" class="b-swap" title="Changer le soignant" onclick="event.stopPropagation(); openReassignModal({{ bloc.id }}, '{{ bloc.patient|e('js') }}', '{{ bloc.hdebut }}', '{{ bloc.hfin }}', {{ iv.id }})">⇄</button>
                  <form method="POST" action="{{ path('admin_planning_annuler', {id: bloc.id}) }}"
                        onsubmit="return confirm('Annuler cette intervention ?')" style="display:inline">
                    <input type="hidden" name="date" value="{{ date }}">
                    <button type="submit" class="b-del" title="Annuler" onclick="event.stopPropagation()">×</button>
                  </form>
                </div>
                {% endfor %}
              </td>
              {% endfor %}
            </tr>
            {% endfor %}
          </tbody>
        </table>
        {% endif %}
      </div>
    </div>

  </div>
</div>

<!-- Modal — Réaffecter un soignant -->
<div class="modal-overlay" id="modalReassign" style="display:none;" onclick="if(event.target===this)closeReassignModal()">
  <div class="modal-panel">
    <div class="modal-header">
      <span class="modal-title">Changer le soignant</span>
      <button class="modal-close" onclick="closeReassignModal()">×</button>
    </div>
    <div class="reassign-info" id="reassign-info"></div>
    <form method="POST" id="reassign-form" action="">
      <input type="hidden" name="date" value="{{ date }}">
      <div class="reassign-soignant-list" id="reassign-list"></div>
      <div id="reassign-conflict-warn" style="display:none;background:#fee2e2;color:#991b1b;border-radius:10px;padding:10px 14px;font-size:12px;font-weight:600;margin-top:12px;">
        ⚠ Ce soignant est déjà occupé sur ce créneau.
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-cancel" onclick="closeReassignModal()">Annuler</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal — Nouvelle intervention -->
<div class="modal-overlay" id="modalIntervention" style="display:none;" onclick="if(event.target===this)closeModal()">
  <div class="modal-panel">
    <div class="modal-header">
      <span class="modal-title">Nouvelle intervention</span>
      <button class="modal-close" onclick="closeModal()">×</button>
    </div>
    <form method="POST" action="{{ path('admin_planning_creer') }}">
      <div class="modal-grid">
        <div class="form-group" style="grid-column:1/-1">
          <label class="form-label">Patient *</label>
          <select class="form-select" name="ben_id" required>
            <option value="">— Sélectionner un patient —</option>
            {% for p in patients %}
            <option value="{{ p.id }}">{{ p.nom }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="form-group" style="grid-column:1/-1">
          <label class="form-label">Soignant *</label>
          <select class="form-select" name="iv_id" id="f-iv" required>
            <option value="">— Sélectionner un soignant —</option>
            {% for s in soignants %}
            <option value="{{ s.id }}">{{ s.nom }}{% if s.specialite %} — {{ s.specialite }}{% endif %}</option>
            {% endfor %}
          </select>
        </div>
        <div class="form-group" style="grid-column:1/-1">
          <label class="form-label">Date *</label>
          <input class="form-input" type="date" name="date" id="f-date" value="{{ date }}" required>
        </div>
        <div class="form-group">
          <label class="form-label">Heure début *</label>
          <select class="form-select" name="h_debut" id="f-h-debut" required>
            {% for h in range(6, 19) %}
            <option value="{{ h }}" {{ h == 9 ? 'selected' : '' }}>{{ '%02d'|format(h) }}:00</option>
            {% endfor %}
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Heure fin *</label>
          <select class="form-select" name="h_fin" id="f-h-fin" required>
            {% for h in range(7, 20) %}
            <option value="{{ h }}" {{ h == 10 ? 'selected' : '' }}>{{ '%02d'|format(h) }}:00</option>
            {% endfor %}
          </select>
        </div>
        <div class="form-group" style="grid-column:1/-1">
          <label class="form-label">Type *</label>
          <select class="form-select" name="type" required>
            <option value="soins">Soins infirmiers</option>
            <option value="toilette">Toilette</option>
            <option value="menage">Ménage</option>
            <option value="repas">Repas</option>
            <option value="accompagnement">Accompagnement</option>
            <option value="surveillance">Surveillance</option>
          </select>
        </div>
      </div>
      <div id="conflict-warning" style="display:none;background:#fee2e2;color:#991b1b;border-radius:10px;padding:10px 14px;font-size:12px;font-weight:600;margin-top:4px;"></div>
      <div class="modal-footer">
        <button type="button" class="btn-cancel" onclick="closeModal()">Annuler</button>
        <button type="submit" class="btn-save" id="btn-submit-planning">Créer l'intervention</button>
      </div>
    </form>
  </div>
</div>

<script>
const OCCUPIED    = {{ occupiedByIv|json_encode|raw }};
const PAGE_DATE   = '{{ date }}';
const SOIGNANTS_DATA = {{ soignants|json_encode|raw }};
</script>
<script src="{{ asset('assets/admin/js/planning.js') }}"></script>
{% endblock %}
