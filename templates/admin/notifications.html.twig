{% extends 'base.html.twig' %}

{% block title %}Notifications — WeCare Admin{% endblock %}

{% block stylesheets %}
<style>
  .page-content { margin-left: var(--sidebar-w); display: flex; flex-direction: column; min-height: 100vh; background: #C8DFF0; }

  /* Topbar */
  .topbar { padding: 28px 32px 16px; flex-shrink: 0; }
  .topbar-title { font-size: 26px; font-weight: 800; color: var(--primary); }

  /* Body */
  .notif-body { flex: 1; display: flex; gap: 20px; padding: 0 32px 28px; min-height: 0; }

  /* List panel */
  .list-panel { width: 420px; flex-shrink: 0; background: #fff; border-radius: 20px; display: flex; flex-direction: column; overflow: hidden; }
  .list-head { padding: 18px 20px 0; }
  .search-wrap { position: relative; margin-bottom: 14px; }
  .search-wrap svg { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #9ca3af; }
  .search-input { width: 100%; padding: 9px 12px 9px 36px; border: 1.5px solid #e5e7eb; border-radius: 30px; font-size: 13px; color: var(--primary); outline: none; }
  .search-input:focus { border-color: var(--pink); }

  /* Tabs */
  .tabs { display: flex; gap: 0; border-bottom: 2px solid #f3f4f6; }
  .tab-btn { padding: 8px 16px; border: none; background: none; font-size: 12px; font-weight: 600; color: #9ca3af; cursor: pointer; position: relative; white-space: nowrap; transition: color 0.15s; }
  .tab-btn.active { color: var(--primary); }
  .tab-btn.active::after { content: ''; position: absolute; bottom: -2px; left: 0; right: 0; height: 2px; background: var(--primary); border-radius: 2px; }
  .tab-badge { background: var(--pink); color: #fff; border-radius: 20px; padding: 1px 6px; font-size: 9.5px; font-weight: 800; margin-left: 4px; }

  /* Notification list */
  .notif-list { flex: 1; overflow-y: auto; padding: 6px 0; }
  .notif-item { display: flex; gap: 12px; align-items: flex-start; padding: 12px 20px; cursor: pointer; transition: background 0.1s; border-bottom: 1px solid #f9fafb; text-decoration: none; }
  .notif-item:last-child { border-bottom: none; }
  .notif-item:hover { background: #f9fafb; }
  .notif-item.active { background: #EEF3FF; border-left: 3px solid var(--primary); padding-left: 17px; }

  .notif-icon-wrap { width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 2px; }
  .notif-icon-wrap.faible   { background: #d1fae5; color: #10b981; }
  .notif-icon-wrap.moderee  { background: #e0f2fe; color: #06b6d4; }
  .notif-icon-wrap.grave    { background: #ffedd5; color: #f97316; }
  .notif-icon-wrap.critique { background: #fee2e2; color: #ef4444; }

  .notif-content { flex: 1; min-width: 0; }
  .notif-header { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; margin-bottom: 3px; }
  .notif-title { font-size: 12.5px; font-weight: 700; color: var(--primary); }
  .notif-time { font-size: 10px; color: #9ca3af; white-space: nowrap; flex-shrink: 0; }
  .notif-text { font-size: 11px; color: #6b7280; line-height: 1.4; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  /* Detail panel */
  .detail-panel { flex: 1; background: #fff; border-radius: 20px; padding: 24px 28px; display: flex; flex-direction: column; gap: 20px; overflow-y: auto; position: relative; }
  .detail-dots { position: absolute; top: 18px; right: 20px; background: #f9fafb; border: 1.5px solid #e5e7eb; border-radius: 8px; padding: 5px 10px; cursor: pointer; font-size: 14px; color: #9ca3af; }

  /* Severity badge */
  .badge-gravite { display: inline-flex; align-items: center; gap: 5px; border-radius: 20px; padding: 4px 12px; font-size: 11px; font-weight: 700; border: 1.5px solid; width: fit-content; }
  .badge-gravite.faible   { background: #d1fae5; color: #065f46; border-color: #6ee7b7; }
  .badge-gravite.moderee  { background: #dbeafe; color: #1e40af; border-color: #93c5fd; }
  .badge-gravite.grave    { background: #ffedd5; color: #9a3412; border-color: #fdba74; }
  .badge-gravite.critique { background: #fee2e2; color: #991b1b; border-color: #fca5a5; }
  .badge-gravite svg { flex-shrink: 0; }

  .detail-title-row { display: flex; flex-direction: column; gap: 4px; border-bottom: 1px solid #f3f4f6; padding-bottom: 16px; }
  .detail-main-title { font-size: 17px; font-weight: 800; color: var(--primary); }
  .detail-subtitle { font-size: 11.5px; color: #9ca3af; }

  /* Détails */
  .detail-section-title { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: #c4b5fd; margin-bottom: 12px; }
  .detail-rows { display: flex; flex-direction: column; gap: 0; }
  .detail-row { display: flex; align-items: flex-start; padding: 10px 0; border-bottom: 1px solid #f9fafb; }
  .detail-row:last-child { border-bottom: none; }
  .detail-row-label { width: 110px; font-size: 11.5px; color: #9ca3af; font-weight: 500; flex-shrink: 0; }
  .detail-row-value { font-size: 12px; font-weight: 700; color: var(--primary); }

  /* Footer button */
  .detail-footer { margin-top: auto; padding-top: 16px; border-top: 1px solid #f3f4f6; display: flex; justify-content: flex-end; }
  .btn-compte-rendu { background: var(--pink); color: #fff; border: none; border-radius: 10px; padding: 11px 24px; font-size: 13px; font-weight: 700; cursor: pointer; transition: opacity 0.15s; }
  .btn-compte-rendu:hover { opacity: 0.88; }

  .no-selected { display: flex; align-items: center; justify-content: center; flex: 1; color: #d1d5db; font-size: 13px; }

  /* Tab content */
  .tab-content { display: none; }
  .tab-content.active { display: flex; flex-direction: column; flex: 1; min-height: 0; }
</style>
{% endblock %}

{% block body %}
{% include 'admin/_sidebar.html.twig' %}

<div class="page-content">
  <div class="topbar">
    <h1 class="topbar-title">Notifications</h1>
  </div>

  <div class="notif-body">

    <!-- Liste -->
    <div class="list-panel">
      <div class="list-head">
        <div class="search-wrap">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="text" class="search-input" placeholder="Rechercher…">
        </div>
        <div class="tabs">
          <button class="tab-btn active" data-tab="alertes">
            Alertes <span class="tab-badge">{{ alertes|length }}</span>
          </button>
          <button class="tab-btn" data-tab="messages">
            Messages <span class="tab-badge" style="background:#9ca3af;">0</span>
          </button>
          <button class="tab-btn" data-tab="historique">Historique</button>
        </div>
      </div>

      <!-- Alertes tab -->
      <div class="tab-content active" id="tab-alertes">
        <div class="notif-list">
          {% for alerte in alertes %}
          <a href="{{ path('admin_notifications', {id: alerte.id}) }}"
             class="notif-item {{ selected and selected.id == alerte.id ? 'active' : '' }}">
            <div class="notif-icon-wrap {{ alerte.gravite }}">
              {% if alerte.gravite == 'critique' or alerte.gravite == 'grave' %}
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
              {% elseif alerte.gravite == 'moderee' %}
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              {% else %}
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              {% endif %}
            </div>
            <div class="notif-content">
              <div class="notif-header">
                <span class="notif-title">{{ alerte.titre }}</span>
                <span class="notif-time">{{ alerte.timeAgo }}</span>
              </div>
              <div class="notif-text">{{ alerte.texte }}</div>
            </div>
          </a>
          {% else %}
          <div style="padding: 32px; text-align: center; color: #d1d5db; font-size: 13px;">Aucune alerte</div>
          {% endfor %}
        </div>
      </div>

      <!-- Messages tab -->
      <div class="tab-content" id="tab-messages">
        <div style="padding: 32px; text-align: center; color: #d1d5db; font-size: 13px; flex: 1;">Aucun message</div>
      </div>

      <!-- Historique tab -->
      <div class="tab-content" id="tab-historique">
        <div style="padding: 32px; text-align: center; color: #d1d5db; font-size: 13px; flex: 1;">Historique vide</div>
      </div>
    </div>

    <!-- Détail -->
    <div class="detail-panel">
      {% if selected %}
      <button class="detail-dots">···</button>

      <span class="badge-gravite {{ selected.gravite }}">
        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          {% if selected.gravite == 'critique' or selected.gravite == 'grave' %}
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
          {% else %}
            <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
          {% endif %}
        </svg>
        {{ selected.gravite|capitalize }}
      </span>

      <div class="detail-title-row">
        <div class="detail-main-title">{{ selected.titre }}</div>
        <div class="detail-subtitle">{{ selected.signalePar }} · {{ selected.timeAgo }}</div>
      </div>

      <div>
        <div class="detail-section-title">Détails</div>
        <div class="detail-rows">
          <div class="detail-row">
            <span class="detail-row-label">Signalé par</span>
            <span class="detail-row-value">{{ selected.signalePar }}</span>
          </div>
          <div class="detail-row">
            <span class="detail-row-label">Patient</span>
            <span class="detail-row-value">{{ selected.patient }}</span>
          </div>
          <div class="detail-row">
            <span class="detail-row-label">Date</span>
            <span class="detail-row-value">{{ selected.date }} à {{ selected.heure }}</span>
          </div>
          <div class="detail-row">
            <span class="detail-row-label">Type / Zone</span>
            <span class="detail-row-value">{{ selected.zone }}</span>
          </div>
          {% if selected.description %}
          <div class="detail-row">
            <span class="detail-row-label">Description</span>
            <span class="detail-row-value" style="font-weight:500; color:#374151; line-height:1.5;">{{ selected.description }}</span>
          </div>
          {% endif %}
        </div>
      </div>

      <div class="detail-footer">
        <button class="btn-compte-rendu">Voir le compte rendu</button>
      </div>
      {% else %}
      <div class="no-selected">Sélectionnez une alerte pour voir les détails</div>
      {% endif %}
    </div>

  </div>
</div>

<script>
// Tabs
document.querySelectorAll('.tab-btn').forEach(btn => {
  btn.addEventListener('click', function () {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
    this.classList.add('active');
    document.getElementById('tab-' + this.dataset.tab).classList.add('active');
  });
});
</script>
{% endblock %}
