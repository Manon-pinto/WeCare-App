<style>
  :root {
    --sidebar-w: 230px;
    --primary: #0F004B;
    --pink: #f472b6;
    --teal-mid: #2dd4bf;
    --radius: 16px;
    --card-shadow: 0 2px 12px rgba(0,0,0,0.07);
    --white: #fff;
    --text-dark: #1a1a3e;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    background: #C8DFF0;
    color: #1a1a3e;
  }

  /* Sidebar */
  .sidebar {
    width: var(--sidebar-w); display: flex; flex-direction: column;
    position: fixed; top: 30px; left: 0; height: calc(100vh - 20px); z-index: 100;
    overflow: visible; background: var(--primary); border-radius: 0 40px 0 0;
  }
  .sidebar-logo-wrap { padding: 28px 20px 20px; display: flex; align-items: center; justify-content: center; }
  .sidebar-logo-wrap img { width: 120px; height: auto; }
  .sidebar-nav { flex: 1; padding: 8px 0; overflow: visible; }
  .nav-item {
    display: flex; align-items: center; gap: 14px; padding: 13px 22px;
    color: rgba(255,255,255,0.65); font-size: 0.92rem; font-weight: 500;
    cursor: pointer; border-radius: 30px; margin: 3px 10px;
    text-decoration: none; transition: background 0.14s;
  }
  .nav-item:hover { background: rgba(255,255,255,0.1); color: #fff; }
  .nav-item svg { opacity: 0.65; flex-shrink: 0; transition: opacity 0.14s; width: 18px; height: 18px; }
  .nav-item:hover svg { opacity: 1; }
  .nav-item.active {
    background: #CC75CA; color: #fff; font-weight: 700;
    border-radius: 14px; margin: 3px 10px; padding: 13px 22px;
    width: auto; position: relative; z-index: 101;
    box-shadow: 0 6px 20px rgba(204, 117, 202, 0.5);
  }
  .nav-item.active svg { opacity: 1; stroke: #fff; width: 18px; height: 18px; }
  .nav-badge { background: var(--pink); color: var(--primary); border-radius: 20px; padding: 1px 7px; font-size: 0.65rem; font-weight: 800; margin-left: auto; }

  .sidebar-user {
    padding: 16px 18px; display: flex; align-items: center; gap: 10px;
    border-top: 1px solid rgba(255,255,255,0.1); text-decoration: none;
    transition: background 0.14s;
  }
  .sidebar-user:hover { background: rgba(255,255,255,0.07); }
  .sidebar-user-avatar { width: 36px; height: 36px; border-radius: 50%; background: var(--teal-mid); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 0.7rem; font-weight: 700; flex-shrink: 0; }
  .sidebar-user-name { color: #fff; font-size: 0.8rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sidebar-user-role { color: rgba(255,255,255,0.5); font-size: 0.68rem; }

  .sidebar-corner-deco {
    position: fixed; bottom: 0; left: var(--sidebar-w);
    width: 62px; height: 62px; z-index: 99; overflow: hidden;
  }
  .sidebar-corner-deco::before {
    content: ''; position: absolute; bottom: 0; left: 0;
    width: 200%; height: 200%; border-radius: 50%;
    box-shadow: -40px 40px 0 0 var(--primary);
  }
</style>

<div class="sidebar">
  <div class="sidebar-logo-wrap">
    <img src="/images/Logo-fond-nuit.png" alt="WeCare">
  </div>
  <nav class="sidebar-nav">
    {% set route = app.request.attributes.get('_route') %}

    <a href="{{ path('admin_dashboard') }}" class="nav-item {{ route == 'admin_dashboard' ? 'active' : '' }}">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
      Dashboard
    </a>

    <a href="{{ path('admin_prises_en_charge') }}" class="nav-item {{ route == 'admin_prises_en_charge' ? 'active' : '' }}">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="13" y2="17"/></svg>
      Prises en charge
    </a>

    <a href="{{ path('admin_patients') }}" class="nav-item {{ route == 'admin_patients' ? 'active' : '' }}">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
      Patients
    </a>

    <a href="{{ path('admin_soignants') }}" class="nav-item {{ route == 'admin_soignants' ? 'active' : '' }}">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      Soignants
    </a>

    <a href="{{ path('admin_planning') }}" class="nav-item {{ route == 'admin_planning' ? 'active' : '' }}">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      Planning
    </a>

    <a href="{{ path('admin_map') }}" class="nav-item {{ route == 'admin_map' ? 'active' : '' }}">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/><line x1="9" y1="3" x2="9" y2="18"/><line x1="15" y1="6" x2="15" y2="21"/></svg>
      Map
    </a>

    <a href="{{ path('admin_notifications') }}" class="nav-item {{ route == 'admin_notifications' ? 'active' : '' }}">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
      Notifications
    </a>

    <a href="{{ path('admin_parametres') }}" class="nav-item {{ route == 'admin_parametres' ? 'active' : '' }}">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
      Paramètres
    </a>
  </nav>

  {% set u = app.user %}
  {% set initiales = u ? u.nom|split(' ')|map(w => w|slice(0,1))|join('')|upper|slice(0,2) : '?' %}
  <a href="#" class="sidebar-user">
    <div class="sidebar-user-avatar">{{ initiales }}</div>
    <div>
      <div class="sidebar-user-name">{{ u ? u.nom : '' }}</div>
      <div class="sidebar-user-role">{{ u and u.role is not null ? u.role.value|capitalize : 'Administrateur' }}</div>
    </div>
  </a>
</div>
<div class="sidebar-corner-deco"></div>
