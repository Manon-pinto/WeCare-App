{% extends 'base.html.twig' %}

{% block title %}Alertes & Notifications — WeCare Admin{% endblock %}

{% block stylesheets %}
<style>
  .page-content {
    margin-left: var(--sidebar-w);
    display: flex; flex-direction: column;
    min-height: 100vh; background: #F2FBFF;
  }

  /* ─── Topbar ─── */
  .topbar {
    padding: 28px 32px 16px;
    display: flex; align-items: center; justify-content: space-between; flex-shrink: 0;
  }
  .topbar h1 { font-size: 26px; font-weight: 800; color: var(--primary); }

  /* ─── Stats row ─── */
  .alertes-body { flex: 1; padding: 8px 36px 40px; display: flex; flex-direction: column; gap: 20px; }
  .stats-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .stat-pill {
    background: #fff; border-radius: 16px; padding: 16px 20px;
    display: flex; align-items: center; gap: 14px;
    box-shadow: 0 8px 28px rgba(16,14,46,0.11), 0 2px 6px rgba(16,14,46,0.05);
  }
  .stat-pill-icon {
    width: 42px; height: 42px; border-radius: 12px;
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .stat-pill-icon.orange { background: #fff3cd; color: #d97706; }
  .stat-pill-icon.blue   { background: #e0f2fe; color: #0284c7; }
  .stat-pill-icon.green  { background: #d1fae5; color: #059669; }
  .stat-pill-icon.gray   { background: #f3f4f6; color: #6b7280; }
  .stat-pill-val { font-size: 24px; font-weight: 900; color: var(--primary); line-height: 1; }
  .stat-pill-lbl { font-size: 11px; font-weight: 600; color: #9ca3af; margin-top: 2px; }

  /* ─── Tabs ─── */
  .tabs-row { display: flex; gap: 8px; }
  .tab-pill {
    border: 1.5px solid #e5e7eb; background: #fff; border-radius: 20px;
    padding: 7px 18px; font-size: 12px; font-weight: 600; color: #6b7280;
    cursor: pointer; transition: all 0.15s; display: flex; align-items: center; gap: 6px;
  }
  .tab-pill.active, .tab-pill:hover {
    background: var(--primary); color: #fff; border-color: var(--primary);
  }
  .tab-count {
    background: var(--pink); color: #fff; border-radius: 20px;
    padding: 1px 7px; font-size: 10px; font-weight: 800;
  }
  .tab-pill:not(.active) .tab-count { background: #e5e7eb; color: #6b7280; }

  /* ─── List section ─── */
  .section { display: none; flex-direction: column; gap: 10px; }
  .section.active { display: flex; }

  /* ─── Incident card ─── */
  .incident-card {
    background: #fff; border-radius: 16px; padding: 18px 22px;
    box-shadow: 0 8px 28px rgba(16,14,46,0.11), 0 2px 6px rgba(16,14,46,0.05);
    display: flex; gap: 16px; align-items: flex-start;
    transition: box-shadow 0.15s; cursor: default;
  }
  .incident-card:hover { box-shadow: 0 16px 48px rgba(16,14,46,0.18), 0 4px 12px rgba(16,14,46,0.08); }

  .inc-icon {
    width: 46px; height: 46px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; border: 2px solid; margin-top: 2px;
  }
  .inc-icon.faible   { border-color: #10b981; color: #10b981; background: #d1fae5; }
  .inc-icon.moderee  { border-color: #f59e0b; color: #d97706; background: #fef3c7; }
  .inc-icon.grave    { border-color: #f97316; color: #ea580c; background: #ffedd5; }
  .inc-icon.critique { border-color: #ef4444; color: #dc2626; background: #fee2e2; }

  .inc-body { flex: 1; min-width: 0; }
  .inc-titre { font-size: 14px; font-weight: 800; color: var(--primary); margin-bottom: 5px; }
  .inc-desc { font-size: 12.5px; color: #6b7280; line-height: 1.55; margin-bottom: 10px; }
  .inc-meta { display: flex; gap: 16px; font-size: 11.5px; color: #9ca3af; flex-wrap: wrap; align-items: center; }
  .inc-meta svg { display: inline; vertical-align: middle; margin-right: 3px; }
  .inc-meta strong { color: #6b7280; font-weight: 600; }

  .inc-badges { display: flex; flex-direction: column; gap: 6px; align-items: flex-end; flex-shrink: 0; }
  .badge {
    display: inline-flex; align-items: center; border-radius: 20px;
    padding: 3px 10px; font-size: 10.5px; font-weight: 700;
  }
  /* statut */
  .badge-signale        { background: #fff3cd; color: #92400e; }
  .badge-en_traitement  { background: #e0f2fe; color: #075985; }
  .badge-resolu         { background: #d1fae5; color: #065f46; }
  .badge-cloture        { background: #f3f4f6; color: #6b7280; }
  /* gravité */
  .badge-faible   { background: #d1fae5; color: #065f46; }
  .badge-moderee  { background: #fef3c7; color: #92400e; }
  .badge-grave    { background: #ffedd5; color: #9a3412; }
  .badge-critique { background: #fee2e2; color: #991b1b; }

  /* ─── Notification card ─── */
  .notif-card {
    background: #fff; border-radius: 16px; padding: 16px 22px;
    box-shadow: 0 8px 28px rgba(16,14,46,0.11), 0 2px 6px rgba(16,14,46,0.05);
    display: flex; gap: 14px; align-items: flex-start;
    transition: box-shadow 0.15s;
  }
  .notif-card:hover { box-shadow: 0 16px 48px rgba(16,14,46,0.18), 0 4px 12px rgba(16,14,46,0.08); }
  .notif-card.non-lu { border-left: 3px solid var(--pink); }

  .notif-icon {
    width: 42px; height: 42px; border-radius: 50%;
    background: #fce7f3; display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; color: var(--pink);
  }
  .notif-body { flex: 1; min-width: 0; }
  .notif-header { display: flex; align-items: center; gap: 8px; margin-bottom: 4px; }
  .notif-label { font-size: 10.5px; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.05em; color: var(--pink); }
  .notif-unread-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--pink); }
  .notif-message { font-size: 12.5px; color: #374151; line-height: 1.55; margin-bottom: 6px; }
  .notif-meta { font-size: 11px; color: #9ca3af; }

  /* ─── Empty state ─── */
  .empty-state {
    display: flex; flex-direction: column; align-items: center;
    justify-content: center; padding: 60px 20px; color: #d1d5db; gap: 12px;
    background: #fff; border-radius: 16px;
  }
  .empty-state p { font-size: 13px; font-weight: 500; }
</style>
{% endblock %}

{% block body %}
{% include 'admin/_sidebar.html.twig' %}

<div class="page-content">

  <div class="topbar">
    <h1>Alertes &amp; Notifications</h1>
  </div>

  <div class="alertes-body">

    {# ── Stats ── #}
    <div class="stats-row">
      <div class="stat-pill">
        <div class="stat-pill-icon orange">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><circle cx="12" cy="16" r=".5" fill="currentColor"/></svg>
        </div>
        <div>
          <div class="stat-pill-val">{{ counts.signale }}</div>
          <div class="stat-pill-lbl">Signalés</div>
        </div>
      </div>
      <div class="stat-pill">
        <div class="stat-pill-icon blue">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div>
          <div class="stat-pill-val">{{ counts.en_traitement }}</div>
          <div class="stat-pill-lbl">En traitement</div>
        </div>
      </div>
      <div class="stat-pill">
        <div class="stat-pill-icon green">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <div>
          <div class="stat-pill-val">{{ counts.resolu }}</div>
          <div class="stat-pill-lbl">Résolus</div>
        </div>
      </div>
      <div class="stat-pill">
        <div class="stat-pill-icon gray">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="9" y1="9" x2="15" y2="15"/><line x1="15" y1="9" x2="9" y2="15"/></svg>
        </div>
        <div>
          <div class="stat-pill-val">{{ counts.cloture }}</div>
          <div class="stat-pill-lbl">Clôturés</div>
        </div>
      </div>
    </div>

    {# ── Tabs ── #}
    <div class="tabs-row">
      <button class="tab-pill active" onclick="showSection('incidents', this)">
        Incidents
        <span class="tab-count">{{ nbIncidents }}</span>
      </button>
      <button class="tab-pill" onclick="showSection('notifications', this)">
        Notifications
        <span class="tab-count">{{ nbNotifs }}</span>
      </button>
    </div>

    {# ── Incidents ── #}
    <div class="section active" id="section-incidents">
      {% if incidents is empty %}
        <div class="empty-state">
          <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="20 6 9 17 4 12"/></svg>
          <p>Aucun incident enregistré</p>
        </div>
      {% else %}
        {% for inc in incidents %}
        <div class="incident-card">
          <div class="inc-icon {{ inc.gravite }}">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" y1="8" x2="12" y2="12"/>
              <circle cx="12" cy="16" r=".5" fill="currentColor"/>
            </svg>
          </div>
          <div class="inc-body">
            <div class="inc-titre">{{ inc.titre }}</div>
            <div class="inc-desc">{{ inc.description }}</div>
            <div class="inc-meta">
              <span>
                <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                <strong>{{ inc.patient }}</strong>
              </span>
              <span>
                <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                {{ inc.intervenant }}
              </span>
              {% if inc.zone %}
              <span>
                <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                {{ inc.zone }}
              </span>
              {% endif %}
              <span>{{ inc.date ? inc.date|date('d/m/Y à H:i') : '' }}</span>
            </div>
          </div>
          <div class="inc-badges">
            <span class="badge badge-{{ inc.statut }}">{{ inc.statutLabel }}</span>
            <span class="badge badge-{{ inc.gravite }}">{{ inc.graviteLabel }}</span>
          </div>
        </div>
        {% endfor %}
      {% endif %}
    </div>

    {# ── Notifications ── #}
    <div class="section" id="section-notifications">
      {% if notifications is empty %}
        <div class="empty-state">
          <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
          <p>Aucune notification</p>
        </div>
      {% else %}
        {% for notif in notifications %}
        <div class="notif-card {{ notif.lu ? '' : 'non-lu' }}">
          <div class="notif-icon">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
          </div>
          <div class="notif-body">
            <div class="notif-header">
              <span class="notif-label">{{ notif.label }}</span>
              {% if not notif.lu %}<span class="notif-unread-dot"></span>{% endif %}
            </div>
            <div class="notif-message">{{ notif.message }}</div>
            <div class="notif-meta">
              {{ notif.user }}
              {% if notif.date %} · {{ notif.date|date('d/m/Y') }}{% endif %}
            </div>
          </div>
        </div>
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<script>
function showSection(name, btn) {
  document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
  document.querySelectorAll('.tab-pill').forEach(b => b.classList.remove('active'));
  document.getElementById('section-' + name).classList.add('active');
  btn.classList.add('active');
}
</script>
{% endblock %}
