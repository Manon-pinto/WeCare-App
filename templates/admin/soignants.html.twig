{% extends 'base.html.twig' %}

{% block title %}Soignants — WeCare Admin{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('assets/admin/css/soignants.css') }}">
{% endblock %}

{% block body %}
{% include 'admin/_sidebar.html.twig' %}

<div class="page-content">
  <div class="topbar">
    <h1 class="topbar-title">Liste des soignants</h1>
    <button class="btn-ajouter" onclick="document.getElementById('modalAjouter').style.display='flex'">
      <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Ajouter un soignant
    </button>
  </div>

  <div class="soignants-body">

    <!-- Liste -->
    <div class="list-panel">
      <div class="list-panel-head">
        <div class="search-wrap">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="text" class="search-input" id="searchInput" placeholder="Rechercher un soignant…">
        </div>
        <div class="list-meta">
          <span class="list-count" id="listCount">{{ soignants|length }} soignant{{ soignants|length > 1 ? 's' : '' }}</span>
        </div>
      </div>

      <div style="overflow-y: auto; flex: 1;">
        <table class="soignants-table">
          <thead>
            <tr>
              <th>Soignant</th>
              <th>Contact</th>
              <th>Semaine</th>
            </tr>
          </thead>
          <tbody id="soignantsBody">
            {% for s in soignants %}
            <tr class="{{ selected and selected.id == s.id ? 'active' : '' }}"
                onclick="window.location='{{ path('admin_soignants', {id: s.id}) }}'">
              <td>
                <div class="iv-cell">
                  <div class="iv-avatar" style="background: {{ s.color }}">{{ s.initiales }}</div>
                  <div>
                    <div class="iv-name">{{ s.nom }}</div>
                    <div class="iv-role">
                      {{ s.specialite }}
                      {% if (s.statut ?? 'actif') != 'actif' %}
                      {% set lblMap = {'conge':'En congé','arret':'Arrêt maladie','formation':'En formation','indisponible':'Indisponible'} %}
                      <span class="statut-badge statut-{{ s.statut }}" style="margin-top:2px;font-size:9.5px;">{{ lblMap[s.statut] ?? s.statut }}</span>
                      {% endif %}
                    </div>
                  </div>
                </div>
              </td>
              <td>
                <div class="contact-cell">
                  <span class="contact-phone">{{ s.telephone }}</span>
                  <span class="contact-email">{{ s.email }}</span>
                </div>
              </td>
              <td>
                {% if s.weekCount > 0 %}
                <span class="week-badge {{ selected and selected.id == s.id ? 'active-badge' : '' }}">
                  {{ s.weekCount }} inter.
                </span>
                {% else %}
                <span style="font-size:11px; color:#d1d5db;">—</span>
                {% endif %}
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Détail -->
    <div class="detail-panel">
      {% if selected %}
      <div class="detail-top">
        <div class="detail-avatar" style="background: {{ selected.color }}">{{ selected.initiales }}</div>
        <div class="detail-meta">
          <div class="detail-name">{{ selected.nom }}</div>
          <div class="detail-sub">{{ selected.specialite }} · Secteur {{ selected.secteur }}</div>
          {% set statutLabels = {
            'actif': 'Actif', 'conge': 'En congé',
            'arret': 'Arrêt maladie', 'formation': 'En formation',
            'indisponible': 'Indisponible'
          } %}
          <span class="statut-badge statut-{{ selected.statut ?? 'actif' }}">
            {{ statutLabels[selected.statut ?? 'actif'] ?? 'Actif' }}
          </span>
        </div>
        <div class="detail-actions">
          <button type="submit" form="soignant-form" class="btn-modifier">
            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            Modifier
          </button>
          <form method="POST" action="{{ path('admin_soignants_supprimer', {id: selected.id}) }}"
                onsubmit="return confirm('Supprimer {{ selected.nom|e('js') }} ? Cette action est irréversible.')">
            <button type="submit" class="btn-supprimer">
              <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
              Supprimer
            </button>
          </form>
        </div>
      </div>

      <form id="soignant-form" method="POST" action="{{ path('admin_soignants_modifier', {id: selected.id}) }}">
      <div class="form-grid">
        <div>
          <div class="form-section-title">Informations personnelles</div>
          <div class="form-group">
            <label class="form-label">Prénom</label>
            <input class="form-input" type="text" name="prenom" value="{{ selected.prenom }}">
          </div>
          <div class="form-group">
            <label class="form-label">Nom</label>
            <input class="form-input" type="text" name="nom_famille" value="{{ selected.nomFamille }}">
          </div>
          <div class="form-group">
            <label class="form-label">Téléphone</label>
            <input class="form-input" type="tel" name="telephone" value="{{ selected.telephone }}">
          </div>
          <div class="form-group">
            <label class="form-label">Email</label>
            <input class="form-input" type="email" name="email" value="{{ selected.email }}">
          </div>
        </div>
        <div>
          <div class="form-section-title">Profil professionnel</div>
          <div class="form-group">
            <label class="form-label">Spécialité</label>
            <select class="form-select" name="specialite">
              <option value="Infirmier(e)"      {{ selected.specialite == 'Infirmier(e)'      ? 'selected' : '' }}>Infirmier(e)</option>
              <option value="Aide-soignant(e)"  {{ selected.specialite == 'Aide-soignant(e)'  ? 'selected' : '' }}>Aide-soignant(e)</option>
              <option value="Auxiliaire de vie" {{ selected.specialite == 'Auxiliaire de vie' ? 'selected' : '' }}>Auxiliaire de vie</option>
              <option value="Kinésithérapeute"  {{ selected.specialite == 'Kinésithérapeute'  ? 'selected' : '' }}>Kinésithérapeute</option>
              <option value="Aide à domicile"   {{ selected.specialite == 'Aide à domicile'   ? 'selected' : '' }}>Aide à domicile</option>
              <option value="Soins infirmiers"  {{ selected.specialite == 'Soins infirmiers'  ? 'selected' : '' }}>Soins infirmiers</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Périmètre d'intervention</label>
            <div class="slider-wrap">
              <div class="slider-header">
                <span style="font-size:11px; color:#6b7280;">0 km</span>
                <span class="slider-val" id="rayonVal">{{ selected.rayon }} KM</span>
                <span style="font-size:11px; color:#6b7280;">50 km</span>
              </div>
              <input type="range" min="1" max="50" value="{{ selected.rayon }}" id="rayonSlider"
                name="rayon"
                oninput="document.getElementById('rayonVal').textContent = this.value + ' KM'">
            </div>
          </div>
          <div class="form-group">
            <label class="form-label">Statut</label>
            <select class="form-select" name="statut">
              <option value="actif"        {{ (selected.statut ?? 'actif') == 'actif'        ? 'selected' : '' }}>Actif</option>
              <option value="conge"        {{ (selected.statut ?? '') == 'conge'        ? 'selected' : '' }}>En congé</option>
              <option value="arret"        {{ (selected.statut ?? '') == 'arret'        ? 'selected' : '' }}>Arrêt maladie</option>
              <option value="formation"    {{ (selected.statut ?? '') == 'formation'    ? 'selected' : '' }}>En formation</option>
              <option value="indisponible" {{ (selected.statut ?? '') == 'indisponible' ? 'selected' : '' }}>Indisponible</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Planning de la semaine — agrandi -->
      <div class="week-planning-section">
        <div class="week-planning-title">Planning de la semaine</div>
        <div class="week-days-row">
          {% for i in 0..6 %}
          <div class="week-day-pill">
            <span class="day-label">{{ selected.jours[i] }}</span>
            <div class="day-count {{ selected.weekGrid[i] > 0 ? 'has-ivs' : 'no-ivs' }}"
                 style="{{ selected.weekGrid[i] > 0 ? 'background:' ~ selected.color : '' }}">
              {% if selected.weekGrid[i] > 0 %}
                <span>{{ selected.weekGrid[i] }}</span>
                <span class="day-count-sub">inter.</span>
              {% else %}
                —
              {% endif %}
            </div>
          </div>
          {% endfor %}
        </div>
        <div class="week-total">
          {% if selected.weekCount > 0 %}
            {{ selected.weekCount }} intervention{{ selected.weekCount > 1 ? 's' : '' }} cette semaine · périmètre {{ selected.rayon }} km
          {% else %}
            Aucune intervention planifiée cette semaine
          {% endif %}
        </div>
      </div>

      <div class="detail-footer">
        <a href="{{ path('admin_soignants', {id: selected.id}) }}" class="btn-annuler">Annuler</a>
        <button type="submit" class="btn-enregistrer">Enregistrer</button>
      </div>
      </form>
      {% else %}
      <div class="no-selected">Sélectionnez un soignant pour voir ses détails</div>
      {% endif %}
    </div>

  </div>
</div>

<!-- ── Modal Ajouter un soignant ── -->
<div class="modal-overlay" id="modalAjouter" style="display:none;"
     onclick="if(event.target===this) closeModal()">
  <div class="modal-panel">
    <div class="modal-header">
      <span class="modal-title">Ajouter un soignant</span>
      <button class="modal-close" onclick="closeModal()">×</button>
    </div>
    <form method="POST" action="{{ path('admin_soignants_ajouter') }}">
      <div class="form-grid">
        <div class="form-group">
          <label class="form-label">Prénom *</label>
          <input class="form-input" name="prenom" type="text" required placeholder="Marie">
        </div>
        <div class="form-group">
          <label class="form-label">Nom *</label>
          <input class="form-input" name="nom_famille" type="text" required placeholder="Dupont">
        </div>
        <div class="form-group">
          <label class="form-label">Email *</label>
          <input class="form-input" name="email" type="email" required placeholder="marie.dupont@wecare.fr">
        </div>
        <div class="form-group">
          <label class="form-label">Téléphone</label>
          <input class="form-input" name="telephone" type="tel" placeholder="06 00 00 00 00">
        </div>
        <div class="form-group">
          <label class="form-label">Spécialité</label>
          <select class="form-select" name="specialite">
            <option>Infirmier(e)</option>
            <option>Aide-soignant(e)</option>
            <option>Auxiliaire de vie</option>
            <option>Kinésithérapeute</option>
            <option>Aide à domicile</option>
            <option>Orthophoniste</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Rayon d'intervention</label>
          <div class="slider-wrap">
            <div class="slider-header">
              <span style="font-size:11px; color:#6b7280;">0 km</span>
              <span class="slider-val" id="modalRayonVal">10 KM</span>
              <span style="font-size:11px; color:#6b7280;">50 km</span>
            </div>
            <input type="range" name="rayon" min="1" max="50" value="10"
              oninput="document.getElementById('modalRayonVal').textContent = this.value + ' KM'">
          </div>
        </div>
      </div>
      <p class="modal-note">Le mot de passe temporaire sera <strong>wecare123</strong> — à changer à la première connexion.</p>
      <div class="modal-footer">
        <button type="button" class="btn-annuler" onclick="closeModal()">Annuler</button>
        <button type="submit" class="btn-enregistrer">Créer le soignant</button>
      </div>
    </form>
  </div>
</div>

<script src="{{ asset('assets/admin/js/soignants.js') }}"></script>
{% endblock %}
