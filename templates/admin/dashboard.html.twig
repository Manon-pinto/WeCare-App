{% extends 'base.html.twig' %}

{% block title %}Dashboard — WeCare Admin{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('assets/admin/css/dashboard.css') }}">
{% endblock %}

{% block body %}
{% include 'admin/_sidebar.html.twig' %}

<div class="page-content">

  <!-- Topbar -->
  <div class="topbar">
    <div class="topbar-greeting">
      <h1>Bonjour {{ prenom }}</h1>
      <p>Voici l'activité du jour</p>
    </div>
    <div class="topbar-actions">
      <div class="chip-date">
        <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        {{ dateLabel }}
      </div>
      <button class="btn-new" onclick="document.getElementById('modalIntervention').style.display='flex'">
        <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Nouvelle intervention
      </button>
    </div>
  </div>

  <div class="dashboard-body">

    <!-- Left column -->
    <div class="dashboard-main">

      <!-- Stats -->
      <div class="stats-row">
        {% for s in stats %}
        <div class="stat-card">
          <div class="stat-card-icon">
            {% if s.icon == 'users' %}
              <svg width="20" height="20" fill="none" stroke="#fff" stroke-width="1.8" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            {% elseif s.icon == 'heart' %}
              <svg width="20" height="20" fill="none" stroke="#fff" stroke-width="1.8" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            {% elseif s.icon == 'clipboard' %}
              <svg width="20" height="20" fill="none" stroke="#fff" stroke-width="1.8" viewBox="0 0 24 24"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="13" y2="16"/></svg>
            {% endif %}
          </div>
          <div class="stat-card-label">{{ s.label }}</div>
          <div>
            <span class="stat-card-value">{{ s.value }}</span>
            <span class="stat-card-suffix">{{ s.suffix }}</span>
          </div>
          <div class="stat-card-sub">{{ s.sub ?? '' }}</div>
        </div>
        {% endfor %}
      </div>

      <!-- Planning -->
      <div class="planning-card">
        <div class="planning-header">
          <span class="planning-header-title">Planning</span>
          <div class="planning-nav">
            <div class="date-nav">
              <a href="{{ path('admin_dashboard', {date: prevDateStr}) }}" class="date-nav-btn">&#8249;</a>
              <span class="date-nav-label">{{ dateLabel }}</span>
              <a href="{{ path('admin_dashboard', {date: nextDateStr}) }}" class="date-nav-btn">&#8250;</a>
            </div>
            <button class="btn-planning" onclick="window.location='{{ path('admin_planning') }}'">
              Voir planning complet
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </button>
          </div>
        </div>

        <div class="planning-body">
          <div class="plan-sidebar">
            {% if intervenantsPlanning is empty %}
              <div class="sector-label" style="margin-top: 0; color: #9ca3af; font-style: italic; text-transform: none; font-size: 10px;">Aucune intervention aujourd'hui</div>
            {% else %}
              <div class="sector-label">Intervenants</div>
              {% for iv in intervenantsPlanning %}
              <label class="int-row checked">
                <input type="checkbox" checked style="accent-color: {{ iv.color }}">
                {{ iv.nom }}
              </label>
              {% endfor %}
            {% endif %}
          </div>

          <div class="plan-calendar">
            {% set nbCols = intervenantsPlanning|length ?: 1 %}
            <div class="cal-avatar-row" style="grid-template-columns: 32px repeat({{ nbCols }}, 1fr);">
              <div></div>
              {% for iv in intervenantsPlanning %}
              <div class="cal-avatar">
                <div class="av-circle" style="background: {{ iv.color }}">{{ iv.initiales }}</div>
                <span class="av-name">{{ iv.prenom }}</span>
              </div>
              {% endfor %}
            </div>

            {% if intervenantsPlanning is empty %}
              <div class="no-planning">Aucune intervention planifiée pour aujourd'hui</div>
            {% else %}
            <div class="cal-grid" style="grid-template-columns: 32px repeat({{ nbCols }}, 1fr);">
              {% for heure in range(7, 17) %}
                <div class="cal-time">{{ heure }}</div>
                {% for iv in intervenantsPlanning %}
                  <div class="cal-cell">
                    {% set cellBlocs = (planningGrid[heure] is defined and planningGrid[heure][iv.id] is defined) ? planningGrid[heure][iv.id] : [] %}
                    {% for bloc in cellBlocs %}
                      <div class="cal-block" style="background: {{ iv.color }}">
                        <span class="b-name">{{ bloc.patient }}</span>
                        <span class="b-time">{{ bloc.hdebut }}-{{ bloc.hfin }}</span>
                      </div>
                    {% endfor %}
                  </div>
                {% endfor %}
              {% endfor %}
            </div>
            {% endif %}
          </div>
        </div>
      </div>

    </div>

    <!-- Right panel -->
    <div class="right-panel">
      <div class="alerts-card">
        <div class="alerts-header">
          <div class="alerts-header-left">
            <div class="alerts-bell-wrap">
              <svg width="20" height="20" fill="none" stroke="#f472b6" stroke-width="2" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
            </div>
            <div>
              <div class="alerts-count-big">{{ alertes|length }}</div>
              <div class="alerts-title">Alertes</div>
            </div>
          </div>
          <a href="{{ path('admin_notifications') }}" class="btn-voir-tout">
            Voir tout
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
        </div>
        <div class="alert-list">
          {% for alerte in alertes %}
          <a href="{{ path('admin_notifications') }}" class="alert-item">
            <div class="alert-icon-wrap {{ alerte.gravite }}">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><circle cx="12" cy="16" r=".5" fill="currentColor"/></svg>
            </div>
            <div>
              <div class="alert-titre">{{ alerte.titre }}</div>
              <div class="alert-texte">{{ alerte.texte }}</div>
            </div>
          </a>
          {% endfor %}
          {% if alertes is empty %}
          <div style="padding: 20px 0; text-align: center; color: #d1d5db; font-size: 12px;">
            Aucune alerte active
          </div>
          {% endif %}
        </div>
      </div>
    </div>

  </div>
</div>

<!-- Modal — Nouvelle intervention -->
<div class="modal-overlay" id="modalIntervention" style="display:none;" onclick="if(event.target===this)this.style.display='none'">
  <div class="modal-panel">
    <div class="modal-header">
      <span class="modal-title">Nouvelle intervention</span>
      <button class="modal-close" onclick="document.getElementById('modalIntervention').style.display='none'">×</button>
    </div>
    <form method="POST" action="{{ path('admin_planning_creer') }}">
      <div class="modal-grid">
        <div class="form-group" style="grid-column:1/-1">
          <label class="form-label">Patient *</label>
          <select class="form-select" name="ben_id" required>
            <option value="">— Sélectionner un patient —</option>
            {% for p in patients %}
            <option value="{{ p.id }}">{{ p.nom }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="form-group" style="grid-column:1/-1">
          <label class="form-label">Soignant *</label>
          <select class="form-select" name="iv_id" required>
            <option value="">— Sélectionner un soignant —</option>
            {% for s in soignants %}
            <option value="{{ s.id }}">{{ s.nom }}{% if s.specialite %} — {{ s.specialite }}{% endif %}</option>
            {% endfor %}
          </select>
        </div>
        <div class="form-group" style="grid-column:1/-1">
          <label class="form-label">Date *</label>
          <input class="form-input" type="date" name="date" value="{{ todayStr }}" required>
        </div>
        <div class="form-group">
          <label class="form-label">Heure début *</label>
          <select class="form-select" name="h_debut" id="dash-h-debut" required>
            {% for h in range(6, 19) %}
            <option value="{{ h }}" {{ h == 9 ? 'selected' : '' }}>{{ '%02d'|format(h) }}:00</option>
            {% endfor %}
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Heure fin *</label>
          <select class="form-select" name="h_fin" id="dash-h-fin" required>
            {% for h in range(7, 20) %}
            <option value="{{ h }}" {{ h == 10 ? 'selected' : '' }}>{{ '%02d'|format(h) }}:00</option>
            {% endfor %}
          </select>
        </div>
        <div class="form-group" style="grid-column:1/-1">
          <label class="form-label">Type *</label>
          <select class="form-select" name="type" required>
            <option value="soins">Soins infirmiers</option>
            <option value="toilette">Toilette</option>
            <option value="menage">Ménage</option>
            <option value="repas">Repas</option>
            <option value="accompagnement">Accompagnement</option>
            <option value="surveillance">Surveillance</option>
          </select>
        </div>
      </div>
      <div id="dash-conflict-warning" style="display:none;background:#fee2e2;color:#991b1b;border-radius:10px;padding:10px 14px;font-size:12px;font-weight:600;margin-top:4px;">
        ⚠ Ce soignant est déjà occupé sur ce créneau — choisissez un autre horaire ou un autre soignant.
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-modal-cancel" onclick="document.getElementById('modalIntervention').style.display='none'">Annuler</button>
        <button type="submit" class="btn-modal-save" id="btn-submit-dash">Créer l'intervention</button>
      </div>
    </form>
  </div>
</div>

<script>
const OCCUPIED_DASH = {{ occupiedByIv|json_encode|raw }};
const TODAY_STR     = '{{ todayStr }}';
</script>
<script src="{{ asset('assets/admin/js/dashboard.js') }}"></script>
{% endblock %}
