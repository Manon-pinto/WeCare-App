<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Inscription – WeCare</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Poppins', sans-serif; background: #f1faf9; min-height: 100vh; display: flex; }

    .split { display: grid; grid-template-columns: 1fr 1fr; min-height: 100vh; width: 100%; }

    .split-form {
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      padding: 48px 56px; background: #fff;
    }
    .form-inner { width: 100%; max-width: 380px; }

    .split-img {
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      padding: 0; position: relative; overflow: hidden;
    }
    .split-img img { width: 100%; height: 100%; object-fit: cover; display: block; }

    .logo { display: flex; align-items: center; gap: 10px; margin-bottom: 28px; }
    .logo img { width: 48px; height: auto; }

    .form-heading { font-size: 1.05rem; font-weight: 800; color: #3fcdc0; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 6px; }
    .form-sub { font-size: 0.82rem; color: #7d6b9e; margin-bottom: 24px; }

    .form-group { margin-bottom: 14px; }
    .form-label { display: block; font-size: 0.78rem; font-weight: 600; color: #3a357f; margin-bottom: 5px; }
    .input-wrap { position: relative; }
    .form-input {
      width: 100%; padding: 10px 14px; border: 1.5px solid #e2ddf0;
      border-radius: 8px; font-family: inherit; font-size: 0.88rem; color: #0c0052;
      background: #f9f8ff; outline: none; transition: border-color 0.15s;
    }
    .form-input:focus { border-color: #3fcdc0; background: #fff; }
    .form-input::placeholder { color: #b0a8cc; }
    .eye-btn { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: #b0a8cc; }

    .form-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
    .check-label { display: flex; align-items: center; gap: 8px; font-size: 0.78rem; color: #7d6b9e; cursor: pointer; }
    .check-label input { accent-color: #3fcdc0; width: 15px; height: 15px; }
    .link { font-size: 0.78rem; color: #3fcdc0; font-weight: 600; text-decoration: none; }
    .link:hover { text-decoration: underline; }

    .btn-submit {
      width: 100%; padding: 13px; background: #3fcdc0; color: #fff;
      border: none; border-radius: 8px; font-family: inherit; font-size: 0.92rem;
      font-weight: 700; cursor: pointer; transition: opacity 0.15s;
    }
    .btn-submit:hover { opacity: 0.88; }
    .btn-submit:disabled { opacity: 0.55; cursor: not-allowed; }

    .alert { padding: 10px 14px; border-radius: 8px; font-size: 0.8rem; margin-bottom: 14px; display: none; }
    .alert-danger { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; }
    .alert-success { background: #f0fdf4; color: #16a34a; border: 1px solid #bbf7d0; }

    @media (max-width: 768px) {
      .split { grid-template-columns: 1fr; }
      .split-img { display: none; }
      .split-form { padding: 32px 24px; }
    }
  </style>
</head>
<body>
<div class="split">
  <div class="split-form">
    <div class="form-inner">
      <div class="logo">
        <img src="/images/Logo-fond-clair.png" alt="WeCare">
      </div>

      <div class="form-heading">Inscrivez-vous</div>
      <div class="form-sub">Bienvenue chez WeCare, créez votre compte.</div>

      <div class="alert alert-danger" id="err"></div>
      <div class="alert alert-success" id="ok"></div>

      <div class="form-group">
        <label class="form-label">Adresse mail</label>
        <input type="email" class="form-input" id="email" placeholder="Entrez votre adresse mail" autocomplete="email">
      </div>

      <div class="form-group">
        <label class="form-label">Mot de passe</label>
        <div class="input-wrap">
          <input type="password" class="form-input" id="mdp" placeholder="Entrez votre mot de passe">
          <button class="eye-btn" type="button" onclick="togglePwd('mdp')">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Confirmez votre mot de passe</label>
        <div class="input-wrap">
          <input type="password" class="form-input" id="mdp2" placeholder="Entrez votre mot de passe">
          <button class="eye-btn" type="button" onclick="togglePwd('mdp2')">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Établissement</label>
        <input type="text" class="form-input" id="etablissement" placeholder="Entrez votre établissement">
      </div>

      <div class="form-row">
        <label class="check-label"><input type="checkbox"> Se souvenir de moi</label>
        <a href="/login" class="link">Vous avez déjà un compte ?</a>
      </div>

      <button class="btn-submit" id="register-btn" onclick="doRegister()">Se connecter</button>
    </div>
  </div>

  <div class="split-img">
    <img src="/images/image-inscription.png" alt="WeCare">
  </div>
</div>

<script>
function togglePwd(id) {
  const inp = document.getElementById(id);
  inp.type = inp.type === 'password' ? 'text' : 'password';
}

async function doRegister() {
  const email = document.getElementById('email').value.trim();
  const mdp = document.getElementById('mdp').value;
  const mdp2 = document.getElementById('mdp2').value;
  const etablissement = document.getElementById('etablissement').value.trim();
  const err = document.getElementById('err');
  const ok = document.getElementById('ok');
  const btn = document.getElementById('register-btn');

  err.style.display = 'none';
  ok.style.display = 'none';

  if (!email || !mdp || !mdp2) { err.textContent = 'Veuillez remplir tous les champs obligatoires.'; err.style.display = 'block'; return; }
  if (mdp !== mdp2) { err.textContent = 'Les mots de passe ne correspondent pas.'; err.style.display = 'block'; return; }
  if (mdp.length < 6) { err.textContent = 'Le mot de passe doit contenir au moins 6 caractères.'; err.style.display = 'block'; return; }

  btn.disabled = true; btn.textContent = 'Inscription…';
  try {
    const r = await fetch('/api/inscription', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email, motDePasse: mdp, etablissement })
    });
    const data = await r.json().catch(() => ({}));
    if (r.ok) {
      ok.textContent = 'Compte créé ! Redirection…';
      ok.style.display = 'block';
      setTimeout(() => window.location.href = '/login', 1500);
    } else {
      err.textContent = data.error || 'Une erreur est survenue.';
      err.style.display = 'block';
    }
  } catch {
    err.textContent = 'Impossible de créer le compte. Vérifiez votre connexion.';
    err.style.display = 'block';
  }
  btn.disabled = false; btn.textContent = 'Se connecter';
}
</script>
</body>
</html>
