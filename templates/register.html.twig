<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Inscription – WeCare</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    /* ── Variables thèmes ── */
    body[data-plan="gratuit"] {
      --bg-page:    #F1FAF9;
      --bg-form:    #F1FAF9;
      --text-label: #3a357f;
      --text-sub:   #7d6b9e;
      --input-bg:   #f9f8ff;
      --input-border: #e2ddf0;
      --input-color: #0c0052;
      --placeholder: #b0a8cc;
      --btn-bg:     #3fcdc0;
      --btn-color:  #fff;
      --btn-text:   "S'inscrire";
      --logo-src:   url('/images/Logo-fond-clair.png');
      --toggle-active-bg:   #3fcdc0;
      --toggle-active-text: #fff;
      --toggle-inactive-bg: transparent;
      --toggle-inactive-text: #7d6b9e;
      --toggle-wrap-bg: #e2ddf0;
      --link-color: #3fcdc0;
      --check-color: #7d6b9e;
    }
    body[data-plan="premium"] {
      --bg-page:    #0f004b;
      --bg-form:    #0f004b;
      --text-label: #e0d8ff;
      --text-sub:   #a89bc8;
      --input-bg:   #1a0e5e;
      --input-border: #2e1f7a;
      --input-color: #ffffff;
      --placeholder: #6a5fa0;
      --btn-bg:     #CC75CA;
      --btn-color:  #fff;
      --toggle-active-bg:   #CC75CA;
      --toggle-active-text: #fff;
      --toggle-inactive-bg: transparent;
      --toggle-inactive-text: #a89bc8;
      --toggle-wrap-bg: #1a0e5e;
      --link-color: #CC75CA;
      --check-color: #a89bc8;
    }

    body {
      font-family: 'Poppins', sans-serif;
      background: var(--bg-page);
      min-height: 100vh;
      display: flex;
      transition: background 0.3s;
    }

    .split { display: grid; grid-template-columns: 1fr 1fr; min-height: 100vh; width: 100%; }

    .split-form {
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      padding: 48px 56px; background: var(--bg-form); transition: background 0.3s;
    }
    .form-inner { width: 100%; max-width: 380px; }

    .split-img {
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      padding: 0; position: relative; overflow: hidden;
    }
    .split-img img { width: 100%; height: 100%; object-fit: cover; display: block; }

    /* ── Logo ── */
    .logo { display: flex; align-items: center; justify-content: center; margin-bottom: 24px; }
    .logo img { width: 180px; height: auto; }

    /* ── Toggle Gratuit / Premium ── */
    .plan-toggle {
      display: flex; align-items: center;
      background: var(--toggle-wrap-bg);
      border-radius: 50px; padding: 4px;
      margin-bottom: 28px; width: 100%; transition: background 0.3s;
    }
    .plan-btn {
      flex: 1; padding: 9px 0; border: none; border-radius: 50px;
      font-family: inherit; font-size: 0.85rem; font-weight: 700; cursor: pointer;
      transition: background 0.2s, color 0.2s;
      background: var(--toggle-inactive-bg);
      color: var(--toggle-inactive-text);
    }
    .plan-btn.active {
      background: var(--toggle-active-bg);
      color: var(--toggle-active-text);
    }

    /* ── Formulaire ── */
    .form-group { margin-bottom: 14px; }
    .form-label {
      display: block; font-size: 0.78rem; font-weight: 600;
      color: var(--text-label); margin-bottom: 5px; transition: color 0.3s;
    }
    .input-wrap { position: relative; }
    .form-input {
      width: 100%; padding: 11px 14px; border: 1.5px solid var(--input-border);
      border-radius: 10px; font-family: inherit; font-size: 0.88rem;
      color: var(--input-color); background: var(--input-bg);
      outline: none; transition: border-color 0.15s, background 0.3s, color 0.3s;
    }
    .form-input:focus { border-color: var(--btn-bg); }
    .form-input::placeholder { color: var(--placeholder); }
    .eye-btn {
      position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
      background: none; border: none; cursor: pointer; color: var(--placeholder);
    }

    .form-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
    .check-label { display: flex; align-items: center; gap: 8px; font-size: 0.78rem; color: var(--check-color); cursor: pointer; }
    .check-label input { accent-color: var(--btn-bg); width: 15px; height: 15px; }
    .link { font-size: 0.78rem; color: var(--link-color); font-weight: 600; text-decoration: none; }
    .link:hover { text-decoration: underline; }

    .btn-submit {
      width: 100%; padding: 13px; background: var(--btn-bg); color: var(--btn-color);
      border: none; border-radius: 10px; font-family: inherit; font-size: 0.92rem;
      font-weight: 700; cursor: pointer; transition: opacity 0.15s, background 0.3s;
    }
    .btn-submit:hover { opacity: 0.88; }
    .btn-submit:disabled { opacity: 0.55; cursor: not-allowed; }

    .alert { padding: 10px 14px; border-radius: 8px; font-size: 0.8rem; margin-bottom: 14px; display: none; }
    .alert-danger { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; }
    .alert-success { background: #f0fdf4; color: #16a34a; border: 1px solid #bbf7d0; }

    /* ── Logo selon thème ── */
    .logo-clair  { display: block; }
    .logo-dark   { display: none; }
    body[data-plan="premium"] .logo-clair { display: none; }
    body[data-plan="premium"] .logo-dark  { display: block; }

    @media (max-width: 768px) {
      .split { grid-template-columns: 1fr; }
      .split-img { display: none; }
      .split-form { padding: 40px 24px; justify-content: flex-start; padding-top: 60px; }
    }
  </style>
</head>
<body data-plan="gratuit">
<div class="split">
  <div class="split-form">
    <div class="form-inner">

      <div class="logo">
        <img class="logo-clair" src="/images/Logo-fond-clair.png" alt="WeCare">
        <img class="logo-dark"  src="/images/Logo-fond-nuit.png" alt="WeCare">
      </div>

      <div class="plan-toggle">
        <button class="plan-btn active" id="btn-gratuit" onclick="setPlan('gratuit')">Gratuit</button>
        <button class="plan-btn"        id="btn-premium" onclick="setPlan('premium')">Premium</button>
      </div>

      <div class="alert alert-danger" id="err"></div>
      <div class="alert alert-success" id="ok"></div>

      <div class="form-group">
        <label class="form-label">Nom complet</label>
        <input type="text" class="form-input" id="nom" placeholder="Entrez votre nom complet" autocomplete="name">
      </div>

      <div class="form-group">
        <label class="form-label">Adresse mail</label>
        <input type="email" class="form-input" id="email" placeholder="Entrez votre adresse mail" autocomplete="email">
      </div>

      <div class="form-group">
        <label class="form-label">Mot de passe</label>
        <div class="input-wrap">
          <input type="password" class="form-input" id="mdp" placeholder="Entrez votre mot de passe">
          <button class="eye-btn" type="button" onclick="togglePwd('mdp')">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Confirmez votre mot de passe</label>
        <div class="input-wrap">
          <input type="password" class="form-input" id="mdp2" placeholder="Entrez votre mot de passe">
          <button class="eye-btn" type="button" onclick="togglePwd('mdp2')">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Établissement</label>
        <input type="text" class="form-input" id="etablissement" placeholder="Entrez votre établissement">
      </div>

      <div class="form-row">
        <label class="check-label"><input type="checkbox"> Se souvenir de moi</label>
        <a href="/login" class="link">Vous avez déjà un compte ?</a>
      </div>

      <button class="btn-submit" id="register-btn" onclick="doRegister()">S'inscrire</button>
    </div>
  </div>

  <div class="split-img">
    <img src="/images/image-inscription.png" alt="WeCare">
  </div>
</div>

<script>
function setPlan(plan) {
  document.body.setAttribute('data-plan', plan);
  document.getElementById('btn-gratuit').classList.toggle('active', plan === 'gratuit');
  document.getElementById('btn-premium').classList.toggle('active', plan === 'premium');
  const btn = document.getElementById('register-btn');
  btn.textContent = plan === 'premium' ? 'Suivant' : "S'inscrire";
}

function togglePwd(id) {
  const inp = document.getElementById(id);
  inp.type = inp.type === 'password' ? 'text' : 'password';
}

async function doRegister() {
  const plan = document.body.getAttribute('data-plan');
  const nom = document.getElementById('nom').value.trim();
  const email = document.getElementById('email').value.trim();
  const mdp = document.getElementById('mdp').value;
  const mdp2 = document.getElementById('mdp2').value;
  const etablissement = document.getElementById('etablissement').value.trim();
  const err = document.getElementById('err');
  const ok = document.getElementById('ok');
  const btn = document.getElementById('register-btn');

  err.style.display = 'none';
  ok.style.display = 'none';

  if (!nom || !email || !mdp || !mdp2) { err.textContent = 'Veuillez remplir tous les champs obligatoires.'; err.style.display = 'block'; return; }
  if (mdp !== mdp2) { err.textContent = 'Les mots de passe ne correspondent pas.'; err.style.display = 'block'; return; }
  if (mdp.length < 6) { err.textContent = 'Le mot de passe doit contenir au moins 6 caractères.'; err.style.display = 'block'; return; }

  btn.disabled = true; btn.textContent = 'Inscription…';
  try {
    const r = await fetch('/api/inscription', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ nom, email, motDePasse: mdp, etablissement, plan })
    });
    const data = await r.json().catch(() => ({}));
    if (r.ok) {
      ok.textContent = 'Compte créé ! Redirection…';
      ok.style.display = 'block';
      setTimeout(() => window.location.href = '/login', 1500);
    } else {
      err.textContent = data.error || 'Une erreur est survenue.';
      err.style.display = 'block';
    }
  } catch {
    err.textContent = 'Impossible de créer le compte. Vérifiez votre connexion.';
    err.style.display = 'block';
  }
  btn.disabled = false;
  btn.textContent = plan === 'premium' ? 'Suivant' : "S'inscrire";
}
</script>
</body>
</html>
