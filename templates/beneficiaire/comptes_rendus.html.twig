{% extends 'beneficiaire/layout.html.twig' %}
{% block title %}Comptes rendus – WeCare{% endblock %}

{% block content %}
<style>
  .cr-topbar { display:flex; align-items:center; justify-content:space-between; margin-bottom:24px; }
  .cr-topbar h1 { font-size:1.6rem; font-weight:800; color:var(--text-dark); }

  .cr-card { background:#fff; border-radius:var(--radius); box-shadow:var(--card-shadow); overflow:hidden; }

  .cr-header-row {
    display:grid; grid-template-columns:1fr 1fr 1fr auto;
    align-items:center; padding:14px 24px;
    border-bottom:1px solid var(--border);
    background:#fff;
  }
  .cr-header-row span { font-size:0.78rem; color:var(--text-muted); }
  .cr-search {
    display:flex; align-items:center; gap:8px;
    border:1.5px solid var(--border); border-radius:20px;
    padding:6px 14px; font-size:0.8rem; background:#fff;
  }
  .cr-search input { border:none; outline:none; font-family:inherit; font-size:0.8rem; color:var(--text-body); background:transparent; width:150px; }

  .cr-item { border-bottom:1px solid var(--border); }
  .cr-item:last-child { border-bottom:none; }

  .cr-row {
    display:grid; grid-template-columns:1fr 1fr 1fr auto;
    align-items:center; padding:16px 24px;
    cursor:pointer; transition:background 0.12s;
    border-left:3px solid transparent;
  }
  .cr-row:hover { background:var(--teal-pale); }
  .cr-row.open { background:#e8f7ff; border-left:3px solid var(--teal-mid); }
  .cr-row-objet { font-size:0.88rem; font-weight:700; color:var(--text-dark); }
  .cr-row-intervenant { font-size:0.85rem; color:var(--text-body); }
  .cr-row-date { font-size:0.85rem; color:var(--text-body); }
  .cr-chevron { color:var(--text-muted); transition:transform 0.2s; }
  .cr-row.open .cr-chevron { transform:rotate(180deg); }

  .cr-detail {
    display:none; padding:24px; background:#f7fdfc;
    border-top:1px solid var(--teal-light);
  }
  .cr-item.expanded .cr-detail { display:grid; grid-template-columns:1fr 1fr; gap:28px; }

  .cr-section-title { font-size:1rem; font-weight:800; color:var(--text-dark); margin-bottom:12px; }
  .cr-sub-title { font-size:0.88rem; font-weight:700; color:var(--text-dark); margin:12px 0 4px; }
  .cr-text { font-size:0.8rem; color:var(--text-body); line-height:1.7; }
  .cr-list { list-style:none; }
  .cr-list li { font-size:0.8rem; color:var(--text-body); line-height:1.7; padding-left:12px; position:relative; }
  .cr-list li::before { content:'•'; position:absolute; left:0; color:var(--teal); }

  @media (max-width: 640px) {
    .cr-topbar { flex-direction:column; align-items:flex-start; gap:10px; }
    .cr-topbar .btn { width:100%; justify-content:center; }
    .cr-header-row { grid-template-columns:1fr auto; }
    .cr-header-row span:nth-child(2),
    .cr-header-row span:nth-child(3) { display:none; }
    .cr-row { grid-template-columns:1fr auto; }
    .cr-row-intervenant, .cr-row-date { display:none; }
    .cr-item.expanded .cr-detail { grid-template-columns:1fr; }
  }
</style>

<div class="cr-topbar">
  <h1>Listes des comptes rendu</h1>
  <a href="{{ path('beneficiaire_contact_wecare') }}" class="btn btn-pink">Demander une visite supplémentaire</a>
</div>

<div class="cr-card">
  <div class="cr-header-row">
    <span>Objet</span>
    <span>Intervenant</span>
    <span>Date</span>
    <div class="cr-search">
      <svg width="14" height="14" fill="none" stroke="var(--text-muted)" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="text" id="cr-search-input" placeholder="Faire une recherche">
    </div>
  </div>

  <div id="cr-list">
    {% for intervention in interventions %}
      {% set cr = intervention.compteRendu %}
      {% if cr %}
      <div class="cr-item" data-search="{{ intervention.typeIntervention ? intervention.typeIntervention.value : '' }} {{ intervention.intervenant.utilisateur.nom }}">
        <div class="cr-row" onclick="toggleCR(this)">
          <span class="cr-row-objet">{{ intervention.typeIntervention ? intervention.typeIntervention.value : 'Visite' }}</span>
          <span class="cr-row-intervenant">{{ intervention.intervenant.utilisateur.nom }}</span>
          <span class="cr-row-date">{{ intervention.dateDebut ? intervention.dateDebut|date('d F Y') : '—' }}</span>
          <svg class="cr-chevron" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
        </div>
        <div class="cr-detail">
          <div>
            <div class="cr-section-title">Compte rendu médical</div>
            <div class="cr-sub-title">Motif de la visite :</div>
            <div class="cr-text">{{ intervention.typeIntervention ? intervention.typeIntervention.value : '' }}</div>
            <div class="cr-sub-title">État général :</div>
            <div class="cr-text">{{ cr.contenu }}</div>
          </div>
          <div>
            <div class="cr-section-title">&nbsp;</div>
            <div class="cr-sub-title">Compte rendu rédigé le :</div>
            <div class="cr-text">{{ cr.dateRedaction ? cr.dateRedaction|date('d/m/Y') : '—' }}</div>
          </div>
        </div>
      </div>
      {% endif %}
    {% else %}
      <div style="padding:40px;text-align:center;color:var(--text-muted);font-size:0.85rem;">Aucun compte rendu disponible.</div>
    {% endfor %}
  </div>
</div>

<script>
function toggleCR(row) {
  const item = row.closest('.cr-item');
  const isOpen = item.classList.contains('expanded');
  document.querySelectorAll('.cr-item.expanded').forEach(i => {
    i.classList.remove('expanded');
    i.querySelector('.cr-row').classList.remove('open');
  });
  if (!isOpen) {
    item.classList.add('expanded');
    row.classList.add('open');
  }
}

document.getElementById('cr-search-input').addEventListener('input', function() {
  const q = this.value.toLowerCase();
  document.querySelectorAll('.cr-item').forEach(item => {
    const text = (item.dataset.search || '') + item.innerText;
    item.style.display = text.toLowerCase().includes(q) ? '' : 'none';
  });
});
</script>
{% endblock %}
