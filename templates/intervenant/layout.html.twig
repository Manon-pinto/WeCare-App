{% extends 'base.html.twig' %}

{% block stylesheets %}
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root {
    --bg:          #F1FAF9;
    --primary:     #0f004b;
    --pink:        #ff91fd;
    --teal:        #41a096;
    --teal-mid:    #3fcdc0;
    --teal-light:  #c5ebe6;
    --teal-pale:   #e0f7f5;
    --text-dark:   #0c0052;
    --text-body:   #3a357f;
    --text-muted:  #8a85b0;
    --white:       #ffffff;
    --border:      #e2ddf0;
    --card-shadow: 0 2px 12px rgba(65,160,150,0.13);
    --radius:      12px;
    --sidebar-w:   210px;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Poppins', sans-serif;
    background: var(--bg);
    color: var(--text-body);
    display: flex;
    min-height: 100vh;
  }

  /* ── Sidebar ── */
  .sidebar {
    width: var(--sidebar-w); display: flex; flex-direction: column;
    position: fixed; top: 30px; left: 0; height: calc(100vh - 20px); z-index: 100;
    overflow: visible; background: var(--primary); border-radius: 0 40px 0 0;
  }
  .sidebar-logo-wrap { padding: 28px 20px 20px; display: flex; align-items: center; justify-content: center; }
  .sidebar-logo-wrap img { width: 120px; height: auto; }
  .sidebar-nav { flex: 1; padding: 8px 0; overflow: visible; }
  .nav-item {
    display: flex; align-items: center; gap: 12px; padding: 11px 20px;
    color: rgba(255,255,255,0.6); font-size: 0.83rem; font-weight: 500;
    cursor: pointer; border-radius: 30px; margin: 2px 10px;
    text-decoration: none; transition: background 0.14s;
  }
  .nav-item:hover { background: rgba(255,255,255,0.08); color: #fff; }
  .nav-item svg { opacity: 0.6; flex-shrink: 0; }
  .nav-item.active {
    background: #CC75CA; color: #fff; font-weight: 700;
    border-radius: 12px; margin: 2px 10px; padding: 11px 20px;
    width: auto; position: relative; z-index: 101;
    box-shadow: 0 4px 15px rgba(204, 117, 202, 0.4);
  }
  .nav-item.active svg { opacity: 1; stroke: #fff; }
  .nav-badge { background: var(--pink); color: var(--primary); border-radius: 20px; padding: 1px 7px; font-size: 0.65rem; font-weight: 800; margin-left: auto; }

  .sidebar-user {
    padding: 16px 18px; display: flex; align-items: center; gap: 10px;
    border-top: 1px solid rgba(255,255,255,0.1); text-decoration: none;
    transition: background 0.14s;
  }
  .sidebar-user:hover { background: rgba(255,255,255,0.07); }
  .sidebar-avatar { width: 36px; height: 36px; border-radius: 50%; background: var(--teal-mid); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 0.7rem; font-weight: 700; flex-shrink: 0; }
  .sidebar-user-info { overflow: hidden; }
  .sidebar-user-name { color: #fff; font-size: 0.8rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sidebar-user-role { color: rgba(255,255,255,0.5); font-size: 0.68rem; }

  .sidebar-corner-deco {
    position: fixed; bottom: 0; left: var(--sidebar-w);
    width: 62px; height: 62px; z-index: 99; overflow: hidden;
  }
  .sidebar-corner-deco::before {
    content: ''; position: absolute; bottom: 0; left: 0;
    width: 200%; height: 200%; border-radius: 50%;
    box-shadow: -40px 40px 0 0 var(--primary);
  }

  /* ── Main ── */
  .main {
    margin-left: var(--sidebar-w);
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .page-content { padding: 28px 32px; flex: 1; }

  /* ── Cards ── */
  .card {
    background: var(--white);
    border-radius: var(--radius);
    padding: 20px;
    box-shadow: var(--card-shadow);
  }

  .card-dark {
    background: var(--primary);
    border-radius: var(--radius);
    padding: 20px;
  }

  .section-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--teal);
    font-weight: 700;
    margin-bottom: 12px;
    display: flex; align-items: center; gap: 6px;
  }

  /* ── Avatar ── */
  .avatar {
    border-radius: 50%;
    background: var(--teal-mid);
    color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; flex-shrink: 0;
  }
  .avatar-sm { width: 34px; height: 34px; font-size: 0.7rem; }
  .avatar-md { width: 44px; height: 44px; font-size: 0.85rem; }
  .avatar-lg { width: 58px; height: 58px; font-size: 1.1rem; }
  .avatar-pink { background: var(--pink); color: var(--primary); }
  .avatar-person {
    border-radius: 50%;
    background: var(--teal-mid);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
  }

  /* ── Badges ── */
  .badge {
    display: inline-flex; align-items: center;
    padding: 3px 10px; border-radius: 20px;
    font-size: 0.68rem; font-weight: 600;
  }
  .badge-prevu     { background: var(--teal-light); color: var(--teal); }
  .badge-redige    { background: var(--teal-light); color: #0d6560; border: 1px solid var(--teal-mid); }
  .badge-a_rediger { background: #fff0b3; color: #7a5800; border: 1px solid #f0c040; }
  .badge-modere    { background: #fff0d0; color: #7a4500; border: 1px solid #f0b060; }
  .badge-grave     { background: #fee2e2; color: #991b1b; }
  .badge-legere    { background: var(--teal-light); color: #065f46; }
  .badge-valide    { background: var(--teal-light); color: #065f46; }

  /* ── Buttons ── */
  .btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 9px 20px; border-radius: 10px;
    font-size: 0.83rem; font-weight: 600; cursor: pointer;
    border: none; transition: all 0.14s;
    text-decoration: none; font-family: 'Poppins', sans-serif;
    white-space: nowrap;
  }
  .btn:hover { opacity: 0.88; }
  .btn:disabled { opacity: 0.5; cursor: not-allowed; }

  .btn-pink     { background: var(--pink); color: var(--primary); }
  .btn-teal     { background: var(--teal-mid); color: #fff; }
  .btn-outline  { background: #fff; color: var(--text-dark); border: 1.5px solid var(--teal-mid); }
  .btn-outline-nav { background: var(--teal-light); color: var(--text-dark); border: none; border-radius: 8px; padding: 7px 16px; font-size: 0.8rem; }
  .btn-ghost    { background: rgba(255,255,255,0.12); color: #fff; border: 1px solid rgba(255,255,255,0.25); }
  .btn-dark     { background: var(--primary); color: #fff; }
  .btn-sm       { padding: 5px 12px; font-size: 0.75rem; border-radius: 8px; }

  /* ── Forms ── */
  .form-group { margin-bottom: 14px; }
  .form-label { display: block; font-size: 0.72rem; font-weight: 600; margin-bottom: 5px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; }
  .form-input {
    width: 100%; padding: 9px 13px;
    border: 1.5px solid var(--border);
    border-radius: 8px; font-size: 0.85rem;
    color: var(--text-dark); background: #fff;
    transition: border-color 0.12s; font-family: 'Poppins', sans-serif;
  }
  .form-input:focus { outline: none; border-color: var(--teal-mid); box-shadow: 0 0 0 3px rgba(63,205,192,0.15); }
  textarea.form-input { resize: vertical; min-height: 90px; }

  /* ── Grid ── */
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; }

  /* ── Loading / Empty ── */
  .loading { display: flex; align-items: center; justify-content: center; padding: 48px; color: var(--text-muted); gap: 10px; font-size: 0.88rem; }
  .empty { text-align: center; padding: 48px 20px; color: var(--text-muted); }
  .empty-icon { font-size: 2rem; margin-bottom: 8px; }
  .empty-title { font-size: 0.9rem; font-weight: 600; color: var(--text-body); margin-bottom: 4px; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .spinner { width: 20px; height: 20px; border: 2px solid var(--teal-light); border-top-color: var(--teal); border-radius: 50%; animation: spin 0.6s linear infinite; }

  /* ── Alerts ── */
  .alert { padding: 10px 14px; border-radius: 8px; font-size: 0.82rem; display: flex; align-items: flex-start; gap: 8px; }
  .alert-danger { background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }
  .alert-success { background: var(--teal-light); color: #065f46; border: 1px solid var(--teal-mid); }

  /* ── Modal ── */
  .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(15,0,75,0.4); z-index: 200; align-items: center; justify-content: center; }
  .modal-overlay.open { display: flex; }
  .modal { background: #fff; border-radius: 14px; padding: 26px; width: 520px; max-width: 94vw; max-height: 90vh; overflow-y: auto; box-shadow: 0 24px 64px rgba(15,0,75,0.2); }
  .modal-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; padding-bottom: 14px; border-bottom: 1px solid var(--border); }
  .modal-title { font-size: 1rem; font-weight: 700; color: var(--text-dark); }
  .modal-close { background: none; border: none; cursor: pointer; color: var(--text-muted); font-size: 1.1rem; width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; transition: background 0.12s; }
  .modal-close:hover { background: var(--teal-light); }
  .modal-footer { display: flex; gap: 10px; justify-content: flex-end; margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--border); }

  /* ── Tabs ── */
  .tab-bar { display: flex; gap: 0; border-bottom: 1.5px solid var(--border); margin-bottom: 20px; }
  .tab-btn {
    padding: 10px 22px; border: none; background: none; cursor: pointer;
    font-size: 0.83rem; font-weight: 500; color: var(--text-muted);
    border-bottom: 2.5px solid transparent; margin-bottom: -1.5px;
    transition: all 0.14s; font-family: 'Poppins', sans-serif;
  }
  .tab-btn.active { color: var(--teal); border-bottom-color: var(--teal); font-weight: 700; background: var(--teal-light); border-radius: 8px 8px 0 0; }
  .tab-panel { display: none; }
  .tab-panel.active { display: block; }

  /* ── Sep ── */
  .sep { height: 1px; background: var(--border); margin: 16px 0; }

  /* ── Map override ── */
  .map-page-content { padding: 0 !important; display: flex; flex-direction: column; flex: 1; overflow: hidden; }
  .main:has(.map-page-content) { overflow: hidden; }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .sidebar { width: 60px; }
    .nav-item span, .sidebar-user-info, .sidebar-logo-text { display: none; }
    .main { margin-left: 60px; }
    .page-content { padding: 18px 14px; }
  }

  /* ── Mobile topbar ── */
  .mobile-topbar { display: none; }

  @media (max-width: 640px) {
    .mobile-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px 18px;
      background: var(--primary);
      border-radius: 0;
      position: sticky; top: 0; z-index: 99;
      flex-shrink: 0;
    }
    .mobile-topbar svg { stroke: rgba(255,255,255,0.8); }
    .mobile-topbar-avatar {
      width: 38px; height: 38px; border-radius: 50%;
      background: var(--teal-mid); color: #fff;
      display: flex; align-items: center; justify-content: center;
      font-size: 0.75rem; font-weight: 700;
      text-decoration: none; flex-shrink: 0;
    }
    .mobile-topbar-title {
      color: #fff;
      font-size: 1rem;
      font-weight: 700;
      margin-left: 10px;
    }
    .main { display: flex; flex-direction: column; }
  }

  /* ── Mobile (bottom nav) ── */
  @media (max-width: 640px) {
    .sidebar { display: none; }
    .main { margin-left: 0; padding-bottom: 68px; }
    .page-content { padding: 16px 16px; }

    .mobile-topbar { position: relative; overflow: visible; }
    .topbar-corner-deco {
      position: absolute; bottom: -62px; left: 0;
      width: 62px; height: 62px; overflow: hidden; pointer-events: none; z-index: 98;
    }
    .topbar-corner-deco::before {
      content: ''; position: absolute; top: 0; left: 0;
      width: 200%; height: 200%; border-radius: 50%;
      box-shadow: -40px -40px 0 0 var(--primary);
    }

    .bottom-nav-corner-left {
      position: fixed; bottom: 62px; left: 0;
      width: 62px; height: 62px; z-index: 149; overflow: hidden; pointer-events: none;
    }
    .bottom-nav-corner-left::before {
      content: ''; position: absolute; bottom: 0; left: 0;
      width: 200%; height: 200%; border-radius: 50%;
      box-shadow: -40px 40px 0 0 var(--primary);
    }

    .bottom-nav {
      display: flex;
      position: fixed;
      bottom: 0; left: 0; right: 0;
      background: var(--primary);
      height: 62px;
      z-index: 150;
      align-items: center;
      justify-content: space-around;
      border-radius: 0;
      box-shadow: 0 -4px 20px rgba(15,0,75,0.2);
    }
    .bn-item {
      display: flex; flex-direction: column; align-items: center; gap: 3px;
      color: rgba(255,255,255,0.45);
      text-decoration: none; font-size: 0.58rem; font-weight: 600;
      padding: 8px 12px; border-radius: 12px; transition: all 0.14s;
      position: relative;
    }
    .bn-item.active { color: var(--pink); }
    .bn-item.active svg { stroke: var(--pink); }
    .bn-item svg { stroke: rgba(255,255,255,0.45); }
    .bn-badge {
      position: absolute; top: 4px; right: 6px;
      background: var(--pink); color: var(--primary);
      font-size: 0.52rem; font-weight: 700;
      padding: 1px 5px; border-radius: 10px; min-width: 16px; text-align: center;
    }

    .grid-2, .grid-3 { grid-template-columns: 1fr; }
  }
  @media (min-width: 641px) {
    .bottom-nav { display: none; }
  }
</style>
{% endblock %}

{% block body %}
{% set route = app.request.attributes.get('_route') %}
{% set userName = app.user ? app.user.nom : 'Intervenant' %}
{% set userInitials = userName|split(' ')|map(p => p|slice(0,1))|join('')|upper|slice(0,2) %}

<aside class="sidebar">
  <div class="sidebar-logo-wrap">
    <img src="/images/Logo-fond-nuit.png" alt="WeCare" style="width:140px; height:auto;">
  </div>

  <nav class="sidebar-nav">
    <a href="{{ path('intervenant_dashboard') }}" class="nav-item {{ route == 'intervenant_dashboard' ? 'active' : '' }}">
      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/>
        <rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>
      </svg>
      <span>Dashboard</span>
    </a>

    <a href="{{ path('intervenant_planning') }}" class="nav-item {{ route == 'intervenant_planning' ? 'active' : '' }}">
      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <rect x="3" y="4" width="18" height="18" rx="2"/>
        <line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
      </svg>
      <span>Mon Planning</span>
    </a>

    <a href="{{ path('intervenant_comptes_rendus') }}" class="nav-item {{ route == 'intervenant_comptes_rendus' ? 'active' : '' }}">
      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/>
        <line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
      </svg>
      <span>Comptes rendus</span>
    </a>

    <a href="{{ path('intervenant_map') }}" class="nav-item {{ route == 'intervenant_map' ? 'active' : '' }}">
      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/>
        <line x1="9" y1="3" x2="9" y2="18"/><line x1="15" y1="6" x2="15" y2="21"/>
      </svg>
      <span>Map</span>
    </a>

    <a href="{{ path('intervenant_notifications') }}" class="nav-item {{ route == 'intervenant_notifications' ? 'active' : '' }}">
      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
        <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
      </svg>
      <span>Notifications</span>
      <span class="nav-badge" id="notif-count" style="display:none"></span>
    </a>
  </nav>

  <a href="{{ path('intervenant_profil') }}" class="sidebar-user">
    <div class="sidebar-avatar">{{ userInitials }}</div>
    <div class="sidebar-user-info" style="flex:1;min-width:0;">
      <div class="sidebar-user-name">{{ userName }}</div>
      <div class="sidebar-user-role">Aide-soignant</div>
    </div>
    <a href="{{ path('app_logout') }}" title="Déconnexion"
       onclick="event.stopPropagation()"
       style="color:rgba(255,255,255,0.4);display:flex;align-items:center;padding:4px;border-radius:6px;transition:color 0.14s;flex-shrink:0;"
       onmouseover="this.style.color='#fff'" onmouseout="this.style.color='rgba(255,255,255,0.4)'">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
        <polyline points="16 17 21 12 16 7"/>
        <line x1="21" y1="12" x2="9" y2="12"/>
      </svg>
    </a>
  </a>
</aside>
<div class="sidebar-corner-deco"></div>

<main class="main">
{% set pageTitle = {
  'intervenant_dashboard':    'Accueil',
  'intervenant_planning':     'Planning',
  'intervenant_comptes_rendus': 'Comptes rendus',
  'intervenant_map':          'Map',
  'intervenant_notifications':'Notifications',
  'intervenant_patients':     'Patients',
  'intervenant_incidents':    'Signalement',
  'intervenant_profil':       'Profil'
}[route] ?? 'WeCare' %}

  <div class="mobile-topbar">
    <a href="{{ path('intervenant_profil') }}" class="mobile-topbar-avatar">{{ userInitials }}</a>
    <span class="mobile-topbar-title">{{ pageTitle }}</span>
    <a href="{{ path('intervenant_notifications') }}" style="position:relative;display:flex;align-items:center;margin-left:auto;margin-right:14px;">
      <svg width="22" height="22" fill="none" stroke="rgba(255,255,255,0.8)" stroke-width="2" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
      <span class="bn-badge" id="mobile-notif-count" style="display:none;position:absolute;top:-4px;right:-4px"></span>
    </a>
    <img src="/images/Logo-fond-nuit.png" alt="WeCare" style="height:48px;width:auto;">
    <div class="topbar-corner-deco"></div>
  </div>
  <div class="page-content {% block content_class %}{% endblock %}">
    {% block content %}{% endblock %}
  </div>
</main>

<div class="bottom-nav-corner-left"></div>
<nav class="bottom-nav">
  <a href="{{ path('intervenant_dashboard') }}" class="bn-item {{ route == 'intervenant_dashboard' ? 'active' : '' }}">
    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
    Accueil
  </a>
  <a href="{{ path('intervenant_planning') }}" class="bn-item {{ route == 'intervenant_planning' ? 'active' : '' }}">
    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
    Planning
  </a>
  <a href="{{ path('intervenant_comptes_rendus') }}" class="bn-item {{ route == 'intervenant_comptes_rendus' ? 'active' : '' }}">
    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
    CR
  </a>
  <a href="{{ path('intervenant_map') }}" class="bn-item {{ route == 'intervenant_map' ? 'active' : '' }}">
    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/><line x1="9" y1="3" x2="9" y2="18"/><line x1="15" y1="6" x2="15" y2="21"/></svg>
    Map
  </a>
  <a href="{{ path('intervenant_notifications') }}" class="bn-item {{ route == 'intervenant_notifications' ? 'active' : '' }}">
    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
    <span id="bn-notif-label">Notifs</span>
    <span class="bn-badge" id="bn-notif-count" style="display:none"></span>
  </a>
</nav>

<script>
fetch('/api/intervenant/notifications')
  .then(r => r.ok ? r.json() : null)
  .then(data => {
    const nonLues = data?.nonLues ?? (Array.isArray(data) ? data.filter(n=>!n.lu).length : 0);
    if (nonLues > 0) {
      const b = document.getElementById('notif-count');
      if (b) { b.textContent = nonLues; b.style.display = 'inline-block'; }
      const bb = document.getElementById('bn-notif-count');
      if (bb) { bb.textContent = nonLues; bb.style.display = 'inline-block'; }
      const bm = document.getElementById('mobile-notif-count');
      if (bm) { bm.textContent = nonLues; bm.style.display = 'inline-block'; }
    }
  }).catch(() => {});
</script>
{% endblock %}
