{% extends 'intervenant/layout.html.twig' %}
{% block title %}Mon profil – WeCare{% endblock %}

{% block content %}
<style>
  .profil-topbar { display:flex; align-items:flex-start; justify-content:space-between; margin-bottom:22px; }
  .profil-heading h1 { font-size:1.5rem; font-weight:800; color:var(--text-dark); }
  .profil-heading p { font-size:0.85rem; color:var(--teal); font-weight:600; margin-top:2px; }

  .profil-banner { background:var(--primary); border-radius:14px; padding:24px 28px; display:flex; align-items:center; gap:22px; margin-bottom:20px; }
  .pb-avatar { width:70px; height:70px; border-radius:50%; background:var(--teal-mid); flex-shrink:0; display:flex; align-items:center; justify-content:center; }
  .pb-name { font-size:1.3rem; font-weight:700; color:rgba(255,255,255,0.5); }
  .pb-info { text-align:right; margin-left:auto; }
  .pb-info-line { font-size:0.82rem; font-weight:700; color:#fff; margin-bottom:2px; }

  .info-card { background:#fff; border-radius:14px; padding:22px 26px; box-shadow:var(--card-shadow); border:2px solid var(--teal-mid); }
  .info-card-title { font-size:0.65rem; text-transform:uppercase; letter-spacing:0.1em; font-weight:700; color:var(--text-muted); margin-bottom:18px; display:flex; align-items:center; gap:6px; }
  .info-field { display:flex; justify-content:space-between; align-items:center; padding:12px 0; border-bottom:1px solid var(--border); }
  .info-field:last-child { border-bottom:none; }
  .info-label { font-size:0.83rem; font-weight:700; color:var(--text-dark); }
  .info-val { font-size:0.83rem; color:var(--text-muted); }

  /* edit form */
  .edit-card { background:#fff; border-radius:14px; padding:22px 26px; box-shadow:var(--card-shadow); margin-top:20px; }
  .edit-title { font-size:1rem; font-weight:700; color:var(--text-dark); margin-bottom:16px; padding-bottom:12px; border-bottom:1px solid var(--border); }

  /* Critères ANSSI */
  .anssi-box { background:#f8f9fc; border:1.5px solid var(--border); border-radius:8px; padding:10px 14px; margin-top:6px; }
  .anssi-box p { font-size:0.75rem; font-weight:700; color:var(--text-muted); margin-bottom:6px; }
  .anssi-item { display:flex; align-items:center; gap:6px; font-size:0.75rem; color:var(--text-muted); margin-bottom:3px; }
  .anssi-item.ok { color:#27ae60; }
  .anssi-icon { width:14px; height:14px; flex-shrink:0; }
</style>

<div class="profil-topbar">
  <div class="profil-heading">
    <h1>Mon profil</h1>
    <p>Informations personnelles</p>
  </div>
  <button class="btn btn-outline" onclick="openEdit()">Modifier</button>
</div>

<div id="profil-view">
  <div class="profil-banner">
    <div class="pb-avatar">
      <svg width="38" height="38" viewBox="0 0 40 40" fill="none"><circle cx="20" cy="14" r="8" fill="rgba(255,255,255,0.35)"/><path d="M4 36c0-8.837 7.163-14 16-14s16 5.163 16 14" stroke="rgba(255,255,255,0.35)" stroke-width="2.5"/></svg>
    </div>
    <div class="pb-name">{{ nom }}</div>
    <div class="pb-info">
      <div class="pb-info-line">{{ specialite ?? '–' }}</div>
      <div class="pb-info-line">Intervenant certifié</div>
      <div class="pb-info-line">Membre depuis</div>
      <div class="pb-info-line">{{ membreDepuis ?? '–' }}</div>
    </div>
  </div>

  <div class="info-card">
    <div class="info-card-title">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      Informations personnelles
    </div>
    <div class="info-field"><span class="info-label">Nom complet</span><span class="info-val" id="if-nom">{{ nom ?? '–' }}</span></div>
    <div class="info-field"><span class="info-label">Email</span><span class="info-val" id="if-email">{{ email ?? '–' }}</span></div>
    <div class="info-field"><span class="info-label">Téléphone</span><span class="info-val" id="if-tel">{{ telephone ?? '–' }}</span></div>
    <div class="info-field"><span class="info-label">Zone d'intervention</span><span class="info-val" id="if-rayon">{{ rayonIntervention ? rayonIntervention ~ ' km' : '–' }}</span></div>
    <div class="info-field"><span class="info-label">Véhicule</span><span class="info-val" id="if-vehicule">{{ vehicule ?? '–' }}</span></div>
  </div>
</div>

<div id="profil-edit" style="display:none">
  <div class="edit-card">
    <div class="edit-title">Modifier mon profil</div>
    <div class="grid-2">
      <div class="form-group"><label class="form-label">Nom</label><input type="text" class="form-input" id="e-nom"></div>
      <div class="form-group"><label class="form-label">Email</label><input type="email" class="form-input" id="e-email"></div>
    </div>
    <div class="grid-2">
      <div class="form-group"><label class="form-label">Téléphone</label><input type="tel" class="form-input" id="e-tel"></div>
      <div class="form-group"><label class="form-label">Spécialité</label><input type="text" class="form-input" id="e-spec"></div>
    </div>
    <div class="grid-2">
      <div class="form-group"><label class="form-label">Rayon (km)</label><input type="number" class="form-input" id="e-rayon" min="1" max="200"></div>
      <div class="form-group"><label class="form-label">Véhicule</label><input type="text" class="form-input" id="e-vehicule" placeholder="Ex : Renault Clio"></div>
    </div>
    <div class="form-group"><label class="form-label">Disponibilité</label>
      <select class="form-input" id="e-dispo"><option value="1">Disponible</option><option value="0">Indisponible</option></select>
    </div>
    <div class="sep"></div>
    <div style="font-size:0.85rem;font-weight:700;color:var(--text-dark);margin-bottom:12px;">Changer le mot de passe <span style="font-weight:400;color:var(--text-muted);font-size:0.78rem;">(laisser vide pour ne pas modifier)</span></div>
    <div class="form-group"><label class="form-label">Mot de passe actuel</label><input type="password" class="form-input" id="e-mdp-ancien" placeholder="Votre mot de passe actuel" autocomplete="current-password"></div>
    <div class="form-group"><label class="form-label">Nouveau mot de passe</label><input type="password" class="form-input" id="e-mdp" placeholder="••••••••••••" autocomplete="new-password" oninput="checkAnssi(this.value)">
      <div class="anssi-box" id="anssi-box" style="display:none">
        <p>Critères de sécurité (ANSSI)</p>
        <div class="anssi-item" id="c-len"><svg class="anssi-icon" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5"/></svg> 12 caractères minimum</div>
        <div class="anssi-item" id="c-maj"><svg class="anssi-icon" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5"/></svg> Une lettre majuscule</div>
        <div class="anssi-item" id="c-min"><svg class="anssi-icon" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5"/></svg> Une lettre minuscule</div>
        <div class="anssi-item" id="c-num"><svg class="anssi-icon" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5"/></svg> Un chiffre</div>
        <div class="anssi-item" id="c-spe"><svg class="anssi-icon" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5"/></svg> Un caractère spécial (!@#$%…)</div>
      </div>
    </div>
    <div class="form-group"><label class="form-label">Confirmer le nouveau mot de passe</label><input type="password" class="form-input" id="e-mdp2" placeholder="••••••••••••" autocomplete="new-password"></div>
    <div id="e-err" style="display:none" class="alert alert-danger"></div>
    <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:16px">
      <button class="btn btn-outline" onclick="closeEdit()">Annuler</button>
      <button class="btn btn-teal" id="e-btn" onclick="save()">Enregistrer</button>
    </div>
  </div>
</div>

<script>
let profilData = {
  nom: {{ nom|json_encode|raw }},
  email: {{ email|json_encode|raw }},
  specialite: {{ specialite|json_encode|raw }},
  telephone: {{ telephone|json_encode|raw }},
  rayonIntervention: {{ rayonIntervention|json_encode|raw }},
  vehicule: {{ vehicule|json_encode|raw }},
  disponibilite: {{ disponibilite ? 'true' : 'false' }},
};

const ANSSI_OK_SVG = `<svg class="anssi-icon" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="7" fill="#27ae60"/><path d="M5 8l2 2 4-4" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const ANSSI_KO_SVG = `<svg class="anssi-icon" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5"/></svg>`;

function setAnssiItem(id, ok, label) {
  const el = document.getElementById(id);
  if (!el) return;
  el.classList.toggle('ok', ok);
  el.innerHTML = (ok ? ANSSI_OK_SVG : ANSSI_KO_SVG) + ' ' + label;
}

function checkAnssi(val) {
  const box = document.getElementById('anssi-box');
  if (box) box.style.display = val.length > 0 ? 'block' : 'none';
  setAnssiItem('c-len', val.length >= 12, '12 caractères minimum');
  setAnssiItem('c-maj', /[A-Z]/.test(val), 'Une lettre majuscule');
  setAnssiItem('c-min', /[a-z]/.test(val), 'Une lettre minuscule');
  setAnssiItem('c-num', /[0-9]/.test(val), 'Un chiffre');
  setAnssiItem('c-spe', /[\W_]/.test(val), 'Un caractère spécial (!@#$%…)');
}

function openEdit(){
  document.getElementById('e-nom').value=profilData.nom||'';
  document.getElementById('e-email').value=profilData.email||'';
  document.getElementById('e-tel').value=profilData.telephone||'';
  document.getElementById('e-spec').value=profilData.specialite||'';
  document.getElementById('e-rayon').value=profilData.rayonIntervention||'';
  document.getElementById('e-vehicule').value=profilData.vehicule||'';
  document.getElementById('e-dispo').value=profilData.disponibilite?'1':'0';
  document.getElementById('e-mdp-ancien').value='';
  document.getElementById('e-mdp').value='';
  document.getElementById('e-mdp2').value='';
  checkAnssi('');
  const err=document.getElementById('e-err');
  err.style.display='none'; err.textContent='';
  document.getElementById('profil-edit').style.display='block';
  document.getElementById('profil-edit').scrollIntoView({behavior:'smooth'});
}

function closeEdit(){ document.getElementById('profil-edit').style.display='none'; }

async function save(){
  const mdpAncien=document.getElementById('e-mdp-ancien').value;
  const mdp=document.getElementById('e-mdp').value;
  const mdp2=document.getElementById('e-mdp2').value;
  const err=document.getElementById('e-err');
  const btn=document.getElementById('e-btn');
  err.style.display='none'; err.textContent='';

  // Si un nouveau MDP est saisi, l'ancien est obligatoire
  if(mdp && !mdpAncien){
    err.textContent='Veuillez saisir votre mot de passe actuel pour le modifier.';
    err.style.display='flex'; return;
  }
  if(mdp && mdp!==mdp2){
    err.textContent='Les nouveaux mots de passe ne correspondent pas.';
    err.style.display='flex'; return;
  }

  // Sauvegarde du profil
  const body={nom:document.getElementById('e-nom').value.trim(),email:document.getElementById('e-email').value.trim(),telephone:document.getElementById('e-tel').value.trim(),specialite:document.getElementById('e-spec').value.trim(),rayonIntervention:parseFloat(document.getElementById('e-rayon').value),disponibilite:document.getElementById('e-dispo').value==='1',vehicule:document.getElementById('e-vehicule').value.trim()};
  btn.disabled=true; btn.textContent='Enregistrement…';
  try {
    const r=await fetch('/api/intervenant/profil',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
    if(!r.ok){ const e=await r.json(); throw new Error(e.error||'Erreur'); }
    Object.assign(profilData, body);
    document.getElementById('if-nom').textContent=body.nom||'–';
    document.getElementById('if-email').textContent=body.email||'–';
    document.getElementById('if-tel').textContent=body.telephone||'–';
    document.getElementById('if-rayon').textContent=body.rayonIntervention?body.rayonIntervention+' km':'–';
    document.getElementById('if-vehicule').textContent=body.vehicule||'–';

    // Changement de MDP si renseigné
    if(mdp){
      const r2=await fetch('/api/intervenant/changer-mdp',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({ancienMotDePasse:mdpAncien,nouveauMotDePasse:mdp,confirmationMotDePasse:mdp2})});
      if(!r2.ok){ const e2=await r2.json(); throw new Error(e2.error||'Erreur MDP'); }
    }
    closeEdit();
  } catch(e){ err.textContent=e.message; err.style.display='flex'; }
  finally{ btn.disabled=false; btn.textContent='Enregistrer'; }
}
</script>
{% endblock %}
