{% extends 'intervenant/layout.html.twig' %}
{% block title %}Notifications – WeCare{% endblock %}

{% block content %}
<style>
  .notif-topbar { display:flex; align-items:flex-start; justify-content:space-between; margin-bottom:22px; }
  .notif-title h1 { font-size:1.5rem; font-weight:800; color:var(--text-dark); }
  .notif-sub { font-size:0.9rem; color:var(--teal); font-weight:600; margin-top:2px; }
  .notif-card { background:#fff; border-radius:14px; padding:8px 0; box-shadow:var(--card-shadow); }
  .notif-item { display:flex; align-items:flex-start; gap:14px; padding:14px 20px; border-left:4px solid transparent; }
  .notif-item.unread { background:#fff8f8; border-left-color:var(--pink); }
  .notif-avatar { width:40px; height:40px; border-radius:50%; background:var(--teal-pale); border:1.5px solid var(--border); display:flex; align-items:center; justify-content:center; flex-shrink:0; }
  .notif-msg { font-size:0.83rem; font-weight:700; color:var(--text-dark); margin-bottom:2px; }
  .notif-txt { font-size:0.76rem; color:var(--text-muted); }
  .notif-sep { height:1px; background:var(--border); margin:0 20px; }
</style>

{% set typeLabels = {
  'rappel': 'Rappel de visite',
  'compte_rendu_soumis': 'Compte rendu soumis pour validation',
  'compte_rendu_valide': 'Compte rendu validé par le coordinateur',
  'incident_signale': 'Incident signalé — en attente de traitement'
} %}

<div class="notif-topbar">
  <div class="notif-title">
    <h1>Notifications</h1>
    <div class="notif-sub">
      {% if nonLues > 0 %}{{ nonLues }} non lue{{ nonLues > 1 ? 's' : '' }}{% else %}Tout est lu{% endif %}
    </div>
  </div>
  <form method="post" action="{{ path('api_intervenant_notifications_lire_tout') }}">
    <input type="hidden" name="_method" value="PATCH">
    <button type="button" class="btn btn-pink" onclick="markAllRead()">Tout marquer comme lu</button>
  </form>
</div>

<div class="notif-card" id="notif-list">
  {% if notifications is empty %}
    <div class="empty"><div class="empty-icon">🔔</div><div class="empty-title">Aucune notification</div></div>
  {% else %}
    {% for n in notifications %}
      <div class="notif-item {{ not n.lu ? 'unread' : '' }}" id="notif-{{ n.id }}" onclick="markRead({{ n.id }})" style="cursor:pointer">
        <div class="notif-avatar">
          <svg width="20" height="20" fill="none" stroke="var(--pink)" stroke-width="1.8" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </div>
        <div style="flex:1">
          <div class="notif-msg">{{ typeLabels[n.type.value] ?? 'Notification' }}</div>
          {% if n.message %}
            <div class="notif-txt">{{ n.message }}</div>
          {% elseif n.compteRendu %}
            <div class="notif-txt">{{ n.compteRendu.intervention.beneficiaire.utilisateur.nom }} · {{ n.compteRendu.intervention.dateDebut|date('d/m/Y') }}</div>
          {% endif %}
          {% if n.createdAt %}
            <div class="notif-txt" style="margin-top:4px;opacity:0.6">{{ n.createdAt|date('d/m/Y') }}</div>
          {% endif %}
        </div>
        {% if not n.lu %}
          <button onclick="markRead({{ n.id }})" style="background:none;border:none;cursor:pointer;color:var(--teal);font-size:0.75rem;white-space:nowrap">Marquer lu</button>
        {% endif %}
      </div>
      {% if not loop.last %}<div class="notif-sep"></div>{% endif %}
    {% endfor %}
  {% endif %}
</div>

<script>
async function markRead(id) {
  await fetch(`/api/intervenant/notifications/${id}/lire`, {method:'PATCH'}).catch(()=>{});
  const el = document.getElementById('notif-' + id);
  if (el) { el.classList.remove('unread'); el.querySelector('button')?.remove(); }
}
async function markAllRead() {
  await fetch('/api/intervenant/notifications/lire-tout', {method:'PATCH'}).catch(()=>{});
  document.querySelectorAll('.notif-item').forEach(el => {
    el.classList.remove('unread');
    el.querySelector('button')?.remove();
  });
  document.querySelector('.notif-sub').textContent = 'Tout est lu';
}
</script>
{% endblock %}
