<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Fonctionnalités WeCare – Pour les services à la personne</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet">
  {{ include('landing/_styles.html.twig') }}
  <style>

    /* ── HERO ── */
    .fn-hero {
      background: #fff;
      text-align: center;
      padding: 72px 48px 56px;
    }
    .fn-hero-tag {
      display: inline-block;
      width: 40px; height: 3px;
      background: #41A096;
      border-radius: 2px;
      margin-bottom: 22px;
    }
    .fn-hero h1 {
      font-size: 2.7rem; font-weight: 800; color: #0c0052;
      line-height: 1.15; margin-bottom: 18px;
    }
    .fn-hero h1 .underline-teal {
      position: relative; display: inline-block;
    }
    .fn-hero h1 .underline-teal::after {
      content: '';
      position: absolute; left: 0; bottom: -4px;
      width: 100%; height: 3px;
      background: #41A096; border-radius: 2px;
    }
    .fn-hero-sub {
      font-size: 0.94rem; color: #8a85b0;
      max-width: 520px; margin: 0 auto;
      line-height: 1.75;
    }
    @media (max-width: 768px) {
      .fn-hero { padding: 52px 24px 40px; }
      .fn-hero h1 { font-size: 1.9rem; }
    }
    @media (max-width: 480px) {
      .fn-hero h1 { font-size: 1.5rem; }
    }

    /* ── TABS SECTION ── */
    .fn-tabs-section {
      background: #fff;
      padding: 64px 48px 72px;
    }
    .fn-tabs-card {
      max-width: 1100px; margin: 0 auto;
      background: #fff;
      border: 1.5px solid #d4cef0;
      border-radius: 20px;
      overflow: hidden;
    }
    .fn-tabs-nav {
      display: flex; gap: 6px;
      padding: 20px 24px;
      border-bottom: 1px solid #ede9f8;
      flex-wrap: wrap;
    }
    .fn-tab-btn {
      padding: 9px 20px; border-radius: 50px;
      font-size: 0.84rem; font-weight: 600;
      border: none; cursor: pointer;
      background: transparent; color: #9b94c5;
      transition: background 0.2s, color 0.2s;
    }
    .fn-tab-btn:hover { color: #0c0052; }
    .fn-tab-btn.active { background: #41A096; color: #fff; }

    .fn-tab-content { display: none; }
    .fn-tab-content.active { display: block; }

    .fn-tab-inner {
      padding: 36px 40px;
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 48px; align-items: center;
    }
    .fn-checklist { display: flex; flex-direction: column; gap: 11px; }
    .fn-check-item {
      display: flex; align-items: flex-start; gap: 10px;
      font-size: 0.875rem; color: #3a357f; font-weight: 500;
      line-height: 1.5;
    }
    .fn-check-icon {
      width: 18px; height: 18px; border-radius: 50%;
      background: #41A096; flex-shrink: 0; margin-top: 1px;
      display: flex; align-items: center; justify-content: center;
    }
    .fn-check-icon svg { width: 10px; height: 10px; }
    .fn-badge-bientot {
      display: inline-block;
      font-size: 0.60rem; font-weight: 700; letter-spacing: 0.06em;
      text-transform: uppercase; color: #3a357f;
      background: #ede9f8; border-radius: 4px;
      padding: 2px 7px; margin-left: 8px;
      vertical-align: middle;
    }
    .fn-tab-visual {
      border-radius: 12px; overflow: hidden;
      background: linear-gradient(135deg, #F2FBFF 0%, #ede9f8 100%);
    }
    .fn-tab-visual .lp-img { height: 340px; border-radius: 12px; }
    .fn-tabs-cta {
      text-align: center; margin-top: 36px;
    }

    @media (max-width: 900px) {
      .fn-tabs-section { padding: 48px 16px 56px; }
      .fn-tab-inner { grid-template-columns: 1fr; padding: 24px; gap: 28px; }
      .fn-tab-visual .lp-img { height: 220px; }
    }

    /* ── COMING SOON INTRO ── */
    .fn-soon-intro {
      text-align: center; padding: 80px 48px 16px;
      background: #fff; /* fond blanc voulu */
    }
    .fn-soon-tag {
      display: inline-block;
      font-size: 0.68rem; font-weight: 700; letter-spacing: 0.14em;
      text-transform: uppercase; color: #41A096;
      background: rgba(65,160,150,0.10); border-radius: 50px;
      padding: 5px 14px; margin-bottom: 20px;
    }
    .fn-soon-intro h2 {
      font-size: 2.1rem; font-weight: 800; color: #0c0052;
      line-height: 1.2; margin-bottom: 14px; max-width: 560px; margin-left: auto; margin-right: auto;
    }
    .fn-soon-intro p {
      font-size: 0.92rem; color: #8a85b0; line-height: 1.7;
      max-width: 480px; margin: 0 auto;
    }

    /* ── FEATURE ROWS ── */
    .fn-soon-grid {
      background: #fff;
      padding: 24px 0 80px;
    }
    .fn-soon-grid-inner {
      max-width: 1100px; margin: 0 auto; padding: 0 48px;
      display: flex; flex-direction: column; gap: 20px;
    }
    .fn-soon-card {
      background: #fff;
      border: 1px solid #eef0f8;
      border-radius: 16px;
      padding: 40px 48px;
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 56px; align-items: center;
      box-shadow: 0 2px 16px rgba(15,0,75,0.04);
    }
    .fn-feature-tag-bientot {
      display: inline-block;
      font-size: 0.62rem; font-weight: 700; letter-spacing: 0.1em;
      text-transform: uppercase; color: #2CA7CB;
      background: rgba(44,167,203,0.10); border-radius: 50px;
      padding: 3px 12px; margin-bottom: 14px;
    }
    .fn-feature-title {
      font-size: 1.55rem; font-weight: 800; color: #0c0052;
      line-height: 1.25; margin-bottom: 12px;
    }
    .fn-feature-desc {
      font-size: 0.88rem; color: #8a85b0;
      line-height: 1.7;
    }
    .fn-feature-bullets { display: flex; flex-direction: column; gap: 12px; }
    .fn-bullet {
      display: flex; align-items: center; gap: 10px;
      font-size: 0.875rem; color: #3a357f; font-weight: 500;
    }
    .fn-bullet-icon {
      width: 20px; height: 20px; border-radius: 50%;
      background: #2CA7CB; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
    }
    .fn-bullet-icon svg { width: 11px; height: 11px; }

    @media (max-width: 900px) {
      .fn-soon-grid-inner { padding: 0 24px; }
      .fn-soon-card { grid-template-columns: 1fr; gap: 28px; padding: 32px 28px; }
    }

    /* ── CTA final (same as homepage) ── */
    .cta-section {
      display: grid; grid-template-columns: 1fr 1fr;
      min-height: 420px; overflow: hidden;
    }
    .cta-img-side { overflow: hidden; }
    .cta-img-side img { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; }
    .cta-text-side {
      background: #F1FAF9;
      display: flex; flex-direction: column; justify-content: center;
      padding: 64px 56px;
    }
    .cta-tag {
      display: inline-block; font-size: 0.68rem; font-weight: 700;
      letter-spacing: 0.12em; text-transform: uppercase;
      color: #41A096; background: rgba(65,160,150,0.10);
      border-radius: 50px; padding: 5px 14px; margin-bottom: 20px; width: fit-content;
    }
    @media (max-width: 900px) {
      .cta-section { grid-template-columns: 1fr; }
      .cta-img-side { min-height: 260px; }
      .cta-text-side { padding: 48px 24px; }
    }
  </style>
</head>
<body>
{{ include('landing/_nav.html.twig') }}

<!-- ── HERO ── -->
<section class="fn-hero">
  <div class="fn-hero-tag"></div>
  <h1>
    Fonctionnalités WeCare,<br>
    <span class="underline-teal">pour les services à la personnes</span>
  </h1>
  <p class="fn-hero-sub">
    WeCare est un logiciel de gestion d'interventions conçu pour les services à la personne afin de valoriser le temps passé auprès des bénéficiaires.
  </p>
</section>

<!-- ── TICKER ── -->
<div class="ticker-wrap-light">
  <div class="ticker-track-light">
    {% for i in 1..4 %}
      <span class="ticker-item-light">
        <span class="ti-icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></span>
        Aucun frais de mise en place
      </span>
      <span class="ticker-item-light">
        <span class="ti-icon"><svg viewBox="0 0 24 24"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg></span>
        Essai gratuit illimité
      </span>
      <span class="ticker-item-light">
        <span class="ti-icon"><svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
        Espace aidant inclus
      </span>
      <span class="ticker-item-light">
        <span class="ti-icon"><svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>
        Sans engagement
      </span>
      <span class="ticker-item-light">
        <span class="ti-icon"><svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span>
        Support 7j/7
      </span>
      <span class="ticker-item-light">
        <span class="ti-icon"><svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></span>
        RGPD &amp; HDS
      </span>
    {% endfor %}
  </div>
</div>

<!-- ── TABS ── -->
<section class="fn-tabs-section">
  <div class="fn-tabs-card reveal">
  <div class="fn-tabs-nav">
    <button class="fn-tab-btn active" data-tab="planning">Planification Intelligente</button>
    <button class="fn-tab-btn" data-tab="multi">Plateforme multi-utilisateurs</button>
    <button class="fn-tab-btn" data-tab="intervention">Gestion d'Intervention</button>
  </div>

  <!-- Tab 1 : Planification Intelligente -->
  <div class="fn-tab-content active" id="tab-planning">
    <div class="fn-tab-inner">
      <div class="fn-checklist reveal-left">
        {% set items_planning = [
          {text: 'Planning en temps réel', soon: false},
          {text: 'Gestion et allocation des tâches', soon: false},
          {text: 'Gestion des compétences des intervenants', soon: false},
          {text: 'Planification intelligente des tournées', soon: false},
          {text: 'Gestion des secteurs et zones d\'interventions', soon: false},
          {text: 'Gestion des absences (congés, arrêts maladies…)', soon: false},
          {text: 'Optimisation des km et des temps de trajets', soon: false},
          {text: 'Géolocalisation des interventions', soon: false},
          {text: 'Gestion des incidents bénéficiaire (hospitalisation, absences…)', soon: false},
          {text: 'Détection de conflits de planning', soon: false},
          {text: 'Notifications d\'actions de planification nécessaires', soon: false},
          {text: 'Assistant de planification IA', soon: true},
        ] %}
        {% for item in items_planning %}
        <div class="fn-check-item">
          <div class="fn-check-icon">
            <svg fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <span>{{ item.text }}{% if item.soon %}<span class="fn-badge-bientot">Bientôt</span>{% endif %}</span>
        </div>
        {% endfor %}
      </div>
      <div class="fn-tab-visual reveal-right">
        <div class="lp-img" style="height:360px;">
          <img src="/images/Gemini_Generated_Image_pidor5pidor5pido.png" alt="Planning intelligent">
        </div>
      </div>
    </div>
  </div>

  <!-- Tab 2 : Plateforme multi-utilisateurs -->
  <div class="fn-tab-content" id="tab-multi">
    <div class="fn-tab-inner">
      <div class="fn-checklist reveal-left">
        {% set items_multi = [
          {text: 'Gestion des rôles et permissions', soon: false},
          {text: 'Espace coordinateur dédié', soon: false},
          {text: 'Application mobile intervenant', soon: false},
          {text: 'Espace aidant / famille sécurisé', soon: false},
          {text: 'Messagerie interne intégrée', soon: false},
          {text: 'Notifications push en temps réel', soon: false},
          {text: 'Tableau de bord personnalisé par profil', soon: false},
          {text: 'Signature électronique des comptes rendus', soon: false},
          {text: 'Accès multi-agences', soon: true},
          {text: 'Single Sign-On (SSO)', soon: true},
        ] %}
        {% for item in items_multi %}
        <div class="fn-check-item">
          <div class="fn-check-icon">
            <svg fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <span>{{ item.text }}{% if item.soon %}<span class="fn-badge-bientot">Bientôt</span>{% endif %}</span>
        </div>
        {% endfor %}
      </div>
      <div class="fn-tab-visual reveal-right">
        <div class="lp-img" style="height:360px;">
          <img src="/images/Sans titre-1 - 31-05-2026 22-28-05(1)-2.png" alt="Plateforme multi-utilisateurs">
        </div>
      </div>
    </div>
  </div>

  <!-- Tab 3 : Gestion d'Intervention -->
  <div class="fn-tab-content" id="tab-intervention">
    <div class="fn-tab-inner">
      <div class="fn-checklist reveal-left">
        {% set items_interv = [
          {text: "Comptes rendus d'intervention", soon: false},
          {text: 'Dictée vocale par reconnaissance IA', soon: false},
          {text: 'Suivi des présences et pointages', soon: false},
          {text: 'Cartographie des tournées interactives', soon: false},
          {text: 'Alertes sur événements critiques', soon: false},
          {text: "Gestion des remplacements d'urgence", soon: false},
          {text: 'Historique complet par bénéficiaire', soon: false},
          {text: "Export des rapports d'intervention", soon: false},
          {text: 'Vérification par QR code / NFC', soon: true},
        ] %}
        {% for item in items_interv %}
        <div class="fn-check-item">
          <div class="fn-check-icon">
            <svg fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <span>{{ item.text }}{% if item.soon %}<span class="fn-badge-bientot">Bientôt</span>{% endif %}</span>
        </div>
        {% endfor %}
      </div>
      <div class="fn-tab-visual reveal-right">
        <div class="lp-img" style="height:360px;">
          <img src="/images/Sans titre-1 - 31-05-2026 22-28-05-4.png" alt="Gestion d'Intervention">
        </div>
      </div>
    </div>
  </div>

  </div>{# /fn-tabs-card #}
  <div class="fn-tabs-cta reveal">
    <a href="/inscription" class="btn-teal">Démarrer gratuitement</a>
  </div>
</section>

<!-- ── COMING SOON INTRO ── -->
<div class="fn-soon-intro reveal">
  <div class="fn-soon-tag">Bientôt</div>
  <h2>WeCare innove avec ces prochaines fonctionnalités</h2>
  <p>Nous améliorons notre logiciel tous les jours afin d'optimiser le pilotage de votre activité.</p>
</div>

<!-- ── FEATURE CARDS "BIENTÔT" ── -->
<div class="fn-soon-grid">
  <div class="fn-soon-grid-inner">

    <div class="fn-soon-card reveal">
      <div>
        <div class="fn-feature-tag-bientot">Bientôt</div>
        <h3 class="fn-feature-title">Assistant de planification IA</h3>
        <p class="fn-feature-desc">Optimisez votre productivité grâce à un assistant IA conçu pour simplifier la planification de vos interventions.</p>
      </div>
      <div class="fn-feature-bullets">
        <div class="fn-bullet">
          <div class="fn-bullet-icon"><svg fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></div>
          <span>Recommandations intelligentes</span>
        </div>
        <div class="fn-bullet">
          <div class="fn-bullet-icon"><svg fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></div>
          <span>Génération automatique de planning</span>
        </div>
        <div class="fn-bullet">
          <div class="fn-bullet-icon"><svg fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></div>
          <span>Gestion et propositions automatiques</span>
        </div>
      </div>
    </div>

    <div class="fn-soon-card reveal">
      <div>
        <div class="fn-feature-tag-bientot">Bientôt</div>
        <h3 class="fn-feature-title">Analyse &amp; Reporting</h3>
        <p class="fn-feature-desc">Pilotez votre activité grâce à des données d'intervention en temps réel et des tableaux de bord personnalisables.</p>
      </div>
      <div class="fn-feature-bullets">
        <div class="fn-bullet">
          <div class="fn-bullet-icon"><svg fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></div>
          <span>Analyse IA</span>
        </div>
        <div class="fn-bullet">
          <div class="fn-bullet-icon"><svg fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></div>
          <span>Tableaux de bord personnalisables</span>
        </div>
        <div class="fn-bullet">
          <div class="fn-bullet-icon"><svg fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></div>
          <span>Export CSV et Excel</span>
        </div>
        <div class="fn-bullet">
          <div class="fn-bullet-icon"><svg fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></div>
          <span>Synchronisation à votre outil BI</span>
        </div>
      </div>
    </div>

    <div class="fn-soon-card reveal">
      <div>
        <div class="fn-feature-tag-bientot">Bientôt</div>
        <h3 class="fn-feature-title">Devis &amp; Facturation</h3>
        <p class="fn-feature-desc">Centralisez la création et l'envoi des devis ainsi que la gestion des factures depuis une seule plateforme.</p>
      </div>
      <div class="fn-feature-bullets">
        <div class="fn-bullet">
          <div class="fn-bullet-icon"><svg fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></div>
          <span>Devis personnalisables</span>
        </div>
        <div class="fn-bullet">
          <div class="fn-bullet-icon"><svg fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></div>
          <span>Envoi par mail et relances automatiques</span>
        </div>
        <div class="fn-bullet">
          <div class="fn-bullet-icon"><svg fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></div>
          <span>Accusé de réception, de lecture et de clic</span>
        </div>
        <div class="fn-bullet">
          <div class="fn-bullet-icon"><svg fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></div>
          <span>Règlement de prestation 100% en ligne</span>
        </div>
      </div>
    </div>

    <div class="fn-soon-card reveal">
      <div>
        <div class="fn-feature-tag-bientot">Bientôt</div>
        <h3 class="fn-feature-title">Comptabilité</h3>
        <p class="fn-feature-desc">Connectez votre compte bancaire et simplifiez au maximum le suivi de votre comptabilité.</p>
      </div>
      <div class="fn-feature-bullets">
        <div class="fn-bullet">
          <div class="fn-bullet-icon"><svg fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></div>
          <span>Tableaux de bords financiers</span>
        </div>
        <div class="fn-bullet">
          <div class="fn-bullet-icon"><svg fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></div>
          <span>Livre des recettes</span>
        </div>
        <div class="fn-bullet">
          <div class="fn-bullet-icon"><svg fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></div>
          <span>Livre des achats</span>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- ── CTA BANNER ── -->
<div class="cta-section">
  <div class="cta-img-side">
    <img src="/images/Welcome-WeCare-RF.webp" alt="WeCare aide à domicile">
  </div>
  <div class="cta-text-side reveal">
    <div class="cta-tag">Offre limitée</div>
    <h2 style="font-size:2rem;font-weight:800;color:#0c0052;margin-bottom:12px;line-height:1.25">Commencez <span style="color:#ff91fd">gratuitement</span><br>dès maintenant</h2>
    <p style="color:#8a85b0;font-size:0.92rem;margin-bottom:28px;line-height:1.7">Plus que 12 mois pour profiter de cette offre gratuite.</p>
    <a href="/inscription" style="display:inline-flex;align-items:center;gap:8px;padding:13px 28px;background:#ff91fd;color:#0f004b;border-radius:10px;font-weight:700;font-size:0.92rem;transition:opacity 0.15s;width:fit-content">
      Essai gratuit
