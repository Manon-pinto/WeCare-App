  {{ include('landing/_styles.html.twig') }}
  <style>
    .ml-hero {
      background: #fff;
      padding: 64px 48px 40px;
      text-align: center;
      border-bottom: 1px solid #f0eef8;
    }
    .ml-hero-bar {
      width: 36px; height: 4px;
      background: #41A096;
      border-radius: 2px;
      margin: 0 auto 20px;
    }
    .ml-hero-title {
      font-size: 2.2rem; font-weight: 800; color: #0c0052;
      line-height: 1.15; margin-bottom: 12px;
    }
    .ml-hero-date {
      font-size: 0.82rem; color: #9a95b8;
    }

    .ml-wrap {
      max-width: 860px;
      margin: 0 auto;
      padding: 56px 48px 80px;
    }

    .ml-section {
      margin-bottom: 48px;
    }
    .ml-section-title {
      font-size: 1.05rem; font-weight: 700; color: #0c0052;
      margin-bottom: 14px;
      display: flex; align-items: center; gap: 10px;
    }
    .ml-section-title::before {
      content: '';
      display: inline-block;
      width: 4px; height: 18px;
      background: #41A096;
      border-radius: 2px;
      flex-shrink: 0;
    }
    .ml-section p,
    .ml-section li {
      font-size: 0.88rem; color: #5a5580; line-height: 1.75;
    }
    .ml-section ul {
      list-style: none; padding: 0; margin: 10px 0 0;
      display: flex; flex-direction: column; gap: 6px;
    }
    .ml-section ul li {
      display: flex; align-items: flex-start; gap: 8px;
    }
    .ml-section ul li::before {
      content: '•'; color: #41A096; font-weight: 800; flex-shrink: 0; margin-top: 1px;
    }
    .ml-section a {
      color: #41A096; font-weight: 600; text-decoration: underline;
    }

    .ml-info-grid {
      display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px;
      margin-top: 16px;
    }
    .ml-info-card {
      background: #FDFBFF;
      border: 1px solid #e8e4f8;
      border-radius: 12px;
      padding: 18px 20px;
    }
    .ml-info-card-label {
      font-size: 0.70rem; font-weight: 700; letter-spacing: 0.09em;
      text-transform: uppercase; color: #41A096; margin-bottom: 6px;
    }
    .ml-info-card-value {
