<script>
document.addEventListener('DOMContentLoaded', () => {

  // ── Pricing slider ──
  const trTiers = [
    { range: "Jusqu'à 50 bénéficiaires",        monthly: 49,  annual: 539,  economy: 49  },
    { range: 'Entre 51 et 100 bénéficiaires',   monthly: 89,  annual: 979,  economy: 89  },
    { range: 'Entre 101 et 150 bénéficiaires',  monthly: 129, annual: 1419, economy: 129 },
    { range: 'Entre 151 et 200 bénéficiaires',  monthly: 169, annual: 1859, economy: 169 },
    { range: 'Entre 201 et 350 bénéficiaires',  monthly: 209, annual: 2299, economy: 209 },
  ];
  const trSlider = document.getElementById('tr-slider');
  function trUpdate() {
    const t = trTiers[+trSlider.value];
    const pct = (+trSlider.value / 4) * 100;
    trSlider.style.background = `linear-gradient(to right,#2CA7CB 0%,#2CA7CB ${pct}%,#d4eef8 ${pct}%,#d4eef8 100%)`;
    document.getElementById('tr-price').textContent       = t.monthly;
    document.getElementById('tr-range').textContent       = t.range;
    document.getElementById('annual-range').textContent   = t.range;
    document.getElementById('annual-price').textContent   = t.annual;
    document.getElementById('annual-yearly').textContent  = 'Économisez ' + t.economy + '€ par an';
    document.getElementById('monthly-price').textContent  = t.monthly;
    document.getElementById('monthly-annual').textContent = 'ou ' + t.annual + '€ / an';
  }
  trSlider?.addEventListener('input', trUpdate);
  trUpdate();

});
</script>
