<script>
document.addEventListener('DOMContentLoaded', () => {

  // ── Slider pricing ──
  const tiers = [
    { label: '1 – 50',       range: 'Jusqu\'à 50 bénéficiaires',        annual: 539,   monthly: 49,  economy: 49  },
    { label: '51 – 100',     range: 'Entre 51 et 100 bénéficiaires',     annual: 979,   monthly: 89,  economy: 89  },
    { label: '101 – 150',    range: 'Entre 101 et 150 bénéficiaires',    annual: 1419,  monthly: 129, economy: 129 },
    { label: '151 – 200',    range: 'Entre 151 et 200 bénéficiaires',    annual: 1859,  monthly: 169, economy: 169 },
    { label: '201 – 350',    range: 'Entre 201 et 350 bénéficiaires',    annual: 2299,  monthly: 209, economy: 209 },
  ];

  const slider      = document.getElementById('benef-slider');
  const display     = document.getElementById('slider-display');
  const annualRange = document.getElementById('annual-range');
  const annualPrice = document.getElementById('annual-price');
  const annualEco   = document.getElementById('annual-economy');
  const monthlyRange= document.getElementById('monthly-range');
  const monthlyPrice= document.getElementById('monthly-price');

  function updatePricing() {
    const t = tiers[+slider.value];
    display.textContent = t.label;
    annualRange.textContent  = t.range;
    monthlyRange.textContent = t.range;

    annualPrice.textContent  = t.annual;
    monthlyPrice.textContent = t.monthly;
    annualEco.textContent    = 'Économisez ' + t.economy + '€ par an';

    // Update slider gradient fill
    const pct = (+slider.value / (tiers.length - 1)) * 100;
    slider.style.background = `linear-gradient(to right, #2CA7CB 0%, #2CA7CB ${pct}%, #d4eef8 ${pct}%, #d4eef8 100%)`;
  }

  slider?.addEventListener('input', updatePricing);
  updatePricing();

  // ── FAQ ──
  document.querySelectorAll('.faq-q').forEach(q => {
    q.addEventListener('click', () => q.parentElement.classList.toggle('open'));
  });
});
</script>
