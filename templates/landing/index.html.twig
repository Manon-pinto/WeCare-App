<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>WeCare – Le logiciel de gestion pour les services à la personne</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  {{ include('landing/_styles.html.twig') }}
  <style>
    /* ── Hero animations ── */
    @keyframes fadeInLeft  { from { opacity:0; transform:translateX(-28px); } to { opacity:1; transform:none; } }
    @keyframes fadeInRight { from { opacity:0; transform:translateX(28px);  } to { opacity:1; transform:none; } }
    .hero-fade-in       { animation: fadeInLeft  0.6s ease both; }
    .hero-fade-in-right { animation: fadeInRight 0.6s ease 0.15s both; }

    /* ── Hero ── */
    .hero-wrap { background: #F1FAF9; overflow: hidden; }
    .hero {
      max-width: 1200px; margin: 0 auto; padding: 80px 48px 0;
      display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center;
    }
    .hero h1 { font-size: 2.8rem; font-weight: 400; color: #0c0052; line-height: 1.15; margin-bottom: 20px; }
    .hero h1 strong { font-weight: 800; }
    .hero-quote { display: flex; align-items: flex-start; gap: 6px; margin: 0 0 28px; }
    .hero-quote-mark { font-size: 2rem; font-weight: 800; color: #41A096; line-height: 1; margin-top: -4px; flex-shrink: 0; }
    .hero-quote em { font-style: italic; font-size: 0.92rem; color: #0c0052; font-weight: 600; line-height: 1.6; }
    .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; }
    .hero-img { position: relative; }
    .hero-img .lp-img { height: 480px; border-radius: 16px 16px 0 0; background: transparent; }
    .hero-img .lp-img img { border-radius: 16px 16px 0 0; }

    /* ── Stats + Tabs ── */
    .stats-wrap { background: #F1FAF9; padding: 64px 48px 0; text-align: center; }
    .stats-dots { display: flex; gap: 6px; justify-content: center; margin-bottom: 14px; }
    .stats-dot { width: 10px; height: 10px; border-radius: 50%; }
    .stats-title { font-size: 2rem; font-weight: 800; color: #0c0052; margin-bottom: 6px; }
    .stats-sub   { font-size: 0.88rem; color: #8a85b0; margin-bottom: 40px; }

    /* Tabs */
    .tabs-section-wrap { background: #F1FAF9; padding: 0 48px 72px; }
    .tabs-card {
      max-width: 1100px; margin: 0 auto;
      background: #fff;
      border: 1.5px solid #d4cef0;
      border-radius: 20px;
      overflow: hidden;
    }
    .tabs-bar {
      display: flex; gap: 6px; align-items: center;
      border-bottom: 1px solid #ede9f8;
      padding: 20px 24px;
    }
    .tab-pill {
      padding: 9px 20px; border: none; background: transparent; cursor: pointer;
      font-family: 'Poppins', sans-serif; font-size: 0.84rem; font-weight: 600;
      color: #9b94c5; border-radius: 50px; transition: all 0.15s;
      white-space: nowrap;
    }
    .tab-pill:hover { color: #0c0052; }
    .tab-pill.active { background: #2CA7CB; color: #fff; }
    .tab-panel { display: none; }
    .tab-panel.active { display: block; }

    .tab-content {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 56px; align-items: center; padding: 40px 40px;
    }
    .tab-text-title {
      font-size: 1.7rem; font-weight: 800; color: #0c0052;
      line-height: 1.25; margin-bottom: 16px;
      border-left: 4px solid #2CA7CB; padding-left: 16px;
    }
    .tab-text-desc { font-size: 0.92rem; color: #8a85b0; line-height: 1.7; margin-bottom: 20px; }
    .tab-list { list-style: none; display: flex; flex-direction: column; gap: 10px; margin-bottom: 28px; }
    .tab-list li { display: flex; align-items: center; gap: 10px; font-size: 0.88rem; font-weight: 600; color: #2CA7CB; }
    .tab-list li::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: #2CA7CB; flex-shrink: 0; }
    .tab-cta {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 11px 24px; border: 1.5px solid #0c0052;
      border-radius: 10px; font-size: 0.88rem; font-weight: 600;
      color: #0c0052; transition: background 0.15s, color 0.15s;
    }
    .tab-cta:hover { background: #0c0052; color: #fff; }
    .tab-img-placeholder { height: 360px; border-radius: 12px; }

    /* ── Carousel "WeCare conçu pour votre structure" ── */
    .carousel-section { background: #fff; padding: 72px 0 64px; }
    .carousel-header { text-align: center; padding: 0 48px; margin-bottom: 40px; }
    .carousel-header h2 { font-size: 2rem; font-weight: 800; color: #0c0052; margin-bottom: 8px; }
    .carousel-header p  { font-size: 0.92rem; color: #8a85b0; }

    .carousel-track-wrap { overflow: hidden; }
    .carousel-track {
      display: flex; gap: 20px; padding: 0 48px;
      transition: transform 0.5s cubic-bezier(.4,0,.2,1);
    }
    .carousel-card {
      min-width: 300px; max-width: 300px; flex-shrink: 0; border-radius: 16px; overflow: hidden;
      position: relative;
    }
    .carousel-card-img {
      width: 100%; height: 220px; object-fit: cover; object-position: center top; display: block;
      background: #e8f4f8;
    }
    .carousel-card-body { padding: 18px 20px; background: #fff; border: 1px solid #f0eef8; border-top: none; border-radius: 0 0 16px 16px; }
    .carousel-card-tag  { display: inline-block; font-size: 0.62rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #41A096; background: rgba(65,160,150,0.10); border-radius: 20px; padding: 2px 10px; margin-bottom: 8px; }
    .carousel-card-title { font-size: 0.92rem; font-weight: 700; color: #0c0052; margin-bottom: 6px; line-height: 1.3; }
    .carousel-card-desc  { font-size: 0.78rem; color: #8a85b0; line-height: 1.5; }
    .carousel-nav { display: none; }
    .carousel-outer { position: relative; }
    .carousel-btn {
      position: absolute; top: 50%; transform: translateY(-50%);
      width: 52px; height: 52px; border-radius: 50%; border: none;
      background: #fff; box-shadow: 0 4px 20px rgba(15,0,75,0.14);
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; transition: background 0.15s, box-shadow 0.15s, color 0.15s;
      color: #0c0052; z-index: 10;
    }
    .carousel-btn:hover { background: #41A096; color: #fff; box-shadow: 0 6px 28px rgba(65,160,150,0.32); }
    #carousel-prev { left: 14px; }
    #carousel-next { right: 14px; }

    /* ── Pricing ── */
    .pricing-section { background: #fff; padding: 72px 48px; }
    .pricing-inner { max-width: 1100px; margin: 0 auto; }
    .pricing-header { text-align: center; margin-bottom: 48px; }
    .pricing-header-bar { width: 40px; height: 3px; background: #41A096; border-radius: 2px; margin: 0 auto 20px; }
    .pricing-header h2 { font-size: 2rem; font-weight: 800; color: #0c0052; margin-bottom: 10px; }
    .pricing-header p  { font-size: 0.9rem; color: #8a85b0; font-style: italic; max-width: 540px; margin: 0 auto; line-height: 1.7; }
    .pricing-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px; }
    .plan-card {
      background: #fff; border-radius: 16px; padding: 32px 28px;
      border: 1px solid #eef0f8;
      transition: transform 0.2s, box-shadow 0.2s;
      display: flex; flex-direction: column;
    }
    .plan-card:hover { transform: translateY(-4px); box-shadow: 0 16px 40px rgba(15,0,75,0.10); }
    .plan-card.featured { background: #0f004b; color: #fff; border-color: #0f004b; }
    .plan-label { font-size: 0.65rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #8a85b0; margin-bottom: 10px; }
    .plan-card.featured .plan-label { color: rgba(255,255,255,0.45); }
    .plan-badge-tag { display: inline-block; background: #41A096; color: #fff; font-size: 0.7rem; font-weight: 700; padding: 4px 14px; border-radius: 20px; margin-bottom: 14px; }
    .plan-range { font-size: 0.88rem; font-weight: 600; color: #0c0052; margin-bottom: 6px; }
    .plan-card.featured .plan-range { color: #fff; }
    .plan-price-row { display: flex; align-items: baseline; gap: 4px; margin-bottom: 4px; }
    .plan-price-big { font-size: 2.8rem; font-weight: 800; color: #0c0052; }
    .plan-card.featured .plan-price-big { color: #fff; }
    .plan-price-unit { font-size: 0.88rem; color: #8a85b0; }
    .plan-card.featured .plan-price-unit { color: rgba(255,255,255,0.5); }
    .plan-price-alt { font-size: 0.78rem; color: #8a85b0; margin-bottom: 20px; }
    .plan-card.featured .plan-price-alt { color: rgba(255,255,255,0.45); }
    .plan-feature-row { display: flex; align-items: center; gap: 8px; font-size: 0.84rem; color: #3a357f; margin-bottom: 10px; }
    .plan-card.featured .plan-feature-row { color: rgba(255,255,255,0.85); }
    .plan-feature-check { width: 18px; height: 18px; border-radius: 50%; background: #41A096; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    #hp-slider::-webkit-slider-thumb { -webkit-appearance:none;width:18px;height:18px;border-radius:50%;background:#41A096;cursor:pointer;box-shadow:0 2px 8px rgba(65,160,150,0.4); }
    #hp-slider::-moz-range-thumb { width:18px;height:18px;border-radius:50%;background:#41A096;cursor:pointer;border:none; }
    .plan-cta { margin-top: auto; padding-top: 20px; }
    .plan-btn {
      display: block; width: 100%; padding: 13px; text-align: center;
      border-radius: 10px; font-size: 0.88rem; font-weight: 700;
      border: 1.5px solid #41A096; color: #41A096;
      transition: all 0.15s;
    }
    .plan-btn:hover { background: #41A096; color: #fff; }
    .plan-btn.primary { background: #ff91fd; border-color: #ff91fd; color: #0f004b; }
    .plan-btn.primary:hover { opacity: 0.88; }

    /* ── FAQ ── */
    .faq-section { background: #fff; }
    .faq-inner { max-width: 860px; margin: 0 auto; padding: 72px 48px; }
    .faq-header { text-align: center; margin-bottom: 40px; }
    .faq-header-bar { width: 32px; height: 3px; background: #41A096; border-radius: 2px; margin: 0 auto 16px; }
    .faq-header h2 { font-size: 1.9rem; font-weight: 800; color: #2CA7CB; margin-bottom: 10px; }
    .faq-header p  { font-size: 0.88rem; color: #2CA7CB; font-style: italic; }
    .faq-item { border-top: 1px solid #ddeaf5; }
    .faq-item:last-child { border-bottom: 1px solid #ddeaf5; }
    .faq-q { display: flex; align-items: center; justify-content: space-between; padding: 20px 0; cursor: pointer; font-size: 0.92rem; font-weight: 600; color: #0c0052; gap: 16px; }
    .faq-q:hover { color: #2CA7CB; }
    .faq-icon { flex-shrink: 0; color: #2CA7CB; transition: transform 0.2s; }
    .faq-item.open .faq-icon { transform: rotate(180deg); }
    .faq-a { display: none; padding: 0 0 20px; font-size: 0.86rem; color: #8a85b0; line-height: 1.7; }
    .faq-item.open .faq-a { display: block; }

    /* ── CTA Final ── */
    .cta-section {
      display: grid; grid-template-columns: 1fr 1fr;
      min-height: 420px; overflow: hidden;
    }
    .cta-img-side { overflow: hidden; }
    .cta-img-side img { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; }
    .cta-text-side {
      background: #F1FAF9;
      display: flex; flex-direction: column; justify-content: center; align-items: center;
      padding: 64px 56px; text-align: center;
    }
    .cta-tag {
      display: inline-block; font-size: 0.68rem; font-weight: 700;
      letter-spacing: 0.12em; text-transform: uppercase;
      color: #41A096; background: rgba(65,160,150,0.10);
      border-radius: 50px; padding: 5px 14px; margin-bottom: 20px; width: fit-content;
    }
    .cta-text-side h2 { font-size: 2rem; font-weight: 800; color: #0c0052; margin-bottom: 12px; line-height: 1.25; }
    .cta-text-side h2 span { color: #ff91fd; }
    .cta-text-side p { color: #8a85b0; font-size: 0.92rem; margin-bottom: 28px; line-height: 1.7; }
    @media (max-width: 900px) {
      .cta-section { grid-template-columns: 1fr; }
      .cta-img-side { min-height: 260px; }
      .cta-text-side { padding: 48px 24px; }
    }

    /* ── Responsive ── */
    @media (max-width: 900px) {
      .hero { grid-template-columns: 1fr; padding: 48px 24px 0; }
      .hero h1 { font-size: 2rem; }
      .tab-content { grid-template-columns: 1fr; gap: 32px; }
      .tab-content-wrap { padding: 0 24px 56px; }
      .pricing-grid { grid-template-columns: 1fr; max-width: 400px; margin-left: auto; margin-right: auto; }
      .carousel-track { padding: 0 24px; }
      .carousel-nav { padding: 20px 24px 0; }
      .faq-inner { padding: 56px 24px; }
      .stats-wrap { padding: 56px 24px 0; }
      .tabs-section-wrap { padding: 0 16px 56px; background: #F1FAF9; }
      .tabs-bar { overflow-x: auto; scrollbar-width: none; }
      .tabs-bar::-webkit-scrollbar { display: none; }
      .tab-content { grid-template-columns: 1fr; padding: 24px; gap: 28px; }
    }
    @media (max-width: 600px) {
      .hero h1 { font-size: 1.6rem; }
      .pricing-section { padding: 56px 20px; }
      .cta-section { padding: 48px 24px; }
    }
  </style>
</head>
<body>
{{ include('landing/_nav.html.twig') }}

<!-- ── HERO ── -->
<div class="hero-wrap">
  <div class="hero">
    <div class="hero-fade-in">
      <h1>Le <strong>logiciel de gestion</strong><br>pour les <strong style="color:#41A096">services à la personne</strong><br>et l'autonomie</h1>
      <blockquote class="hero-quote">
        <span class="hero-quote-mark">"</span>
        <em>Vous prenez soin de nos familles,<br>à nous de prendre soin de vous.</em>
      </blockquote>
      <div class="hero-ctas">
        <a href="/inscription" class="btn-teal">Essai gratuit</a>
        <a href="/contact" class="btn-outline">Nous contacter</a>
      </div>
    </div>
    <div class="hero-img hero-fade-in-right">
      {# → /public/images/lp/hero.jpg #}
      <div class="lp-img" style="height:480px;border-radius:16px 16px 0 0">
        <img src="/images/ADV_emploi_aide_a_dom_bloc1_13cb6117ce.jpg" alt="WeCare aide à domicile" onerror="this.style.display='none'">
        <span class="lp-img-icon" style="display:none"></span><span style="display:none"></span>
      </div>
    </div>
  </div>
</div>

<!-- ── TICKER ── -->
<div class="ticker-wrap-light">
  <div class="ticker-track-light">
    {% for i in 1..4 %}
      <span class="ticker-item-light"><span class="ti-icon"><svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>Aucun frais de mise en place</span>
      <span class="ticker-item-light"><span class="ti-icon"><svg viewBox="0 0 24 24"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg></span>Essai gratuit illimité</span>
      <span class="ticker-item-light"><span class="ti-icon"><svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>Espace aidant inclus</span>
      <span class="ticker-item-light"><span class="ti-icon"><svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>Sans engagement</span>
      <span class="ticker-item-light"><span class="ti-icon"><svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span>Support 7j/7</span>
      <span class="ticker-item-light"><span class="ti-icon"><svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></span>RGPD &amp; HDS</span>
    {% endfor %}
  </div>
</div>

<!-- ── STATS + TABS ── -->
<div class="stats-wrap">
  <div class="stats-dots reveal">
    <span class="stats-dot" style="background:#2CA7CB"></span>
    <span class="stats-dot" style="background:#ff91fd"></span>
    <span class="stats-dot" style="background:#41A096"></span>
  </div>
  <div class="stats-title reveal">WeCare, s'occupe de tout le monde</div>
  <div class="stats-sub reveal">3 utilisateurs ; 3 espaces distincts</div>

</div>

<div class="tabs-section-wrap">
  <div class="tabs-card reveal">
    <div class="tabs-bar">
      <button class="tab-pill active" onclick="switchTab(0,this)">Responsable de secteur</button>
      <button class="tab-pill"        onclick="switchTab(1,this)">Aidant &amp; bénéficiaire</button>
      <button class="tab-pill"        onclick="switchTab(2,this)">Intervenant</button>
    </div>
  <div class="tab-panel active" id="tab-0">
    <div class="tab-content">
      <div>
        <h2 class="tab-text-title">Optimisez la planification des tournées et la gestion de vos équipes</h2>
        <p class="tab-text-desc">Centralisez le suivi de vos bénéficiaires, coordonnez vos équipes et simplifiez la planification des tournées depuis une seule plateforme.</p>
        <ul class="tab-list">
          <li>Planification intelligente des tournées</li>
          <li>Optimisation des trajets</li>
          <li>Gestion des incidents terrain</li>
        </ul>
        <a href="/fonctionnalites" class="tab-cta">Découvrir les fonctionnalités</a>
      </div>
      <div class="tab-img-placeholder lp-img">
        {# → /public/images/lp/feature-responsable.jpg #}
        <img src="/images/Gemini_Generated_Image_11u53q11u53q11u5.png" alt="Responsable de secteur" onerror="this.style.display='none'">
        <span class="lp-img-icon" style="display:none"></span><span style="display:none"></span>
      </div>
    </div>
  </div>
  <div class="tab-panel" id="tab-1">
    <div class="tab-content">
      <div>
        <h2 class="tab-text-title">Un espace dédié aux familles et aux bénéficiaires</h2>
        <p class="tab-text-desc">Consultez le planning des visites, les comptes rendus d'intervention et communiquez avec l'équipe soignante en toute transparence.</p>
        <ul class="tab-list">
          <li>Consultation du planning des visites</li>
          <li>Lecture des comptes rendus</li>
          <li>Messagerie avec l'équipe soignante</li>
        </ul>
        <a href="/fonctionnalites" class="tab-cta">Découvrir les fonctionnalités</a>
      </div>
      <div class="tab-img-placeholder lp-img">
        {# → /public/images/lp/feature-aidant.jpg #}
        <img src="/images/Gemini_Generated_Image_eb0lyweb0lyweb0l-clean.png" alt="Aidant bénéficiaire" onerror="this.style.display='none'">
        <span class="lp-img-icon" style="display:none"></span><span style="display:none"></span>
      </div>
    </div>
  </div>
  <div class="tab-panel" id="tab-2">
    <div class="tab-content">
      <div>
        <h2 class="tab-text-title">Tout ce dont l'intervenant a besoin sur le terrain</h2>
        <p class="tab-text-desc">Accédez à votre planning, aux fiches patients et rédigez vos comptes rendus directement depuis votre téléphone.</p>
        <ul class="tab-list">
          <li>Planning du jour en temps réel</li>
          <li>Fiche patient complète</li>
          <li>Compte rendu vocal ou écrit</li>
        </ul>
        <a href="/fonctionnalites" class="tab-cta">Découvrir les fonctionnalités</a>
      </div>
      <div class="tab-img-placeholder lp-img">
        {# → /public/images/lp/feature-intervenant.jpg #}
        <img src="/images/Gemini_Generated_Image_60bpzs60bpzs60bp-clean.png" alt="Intervenant" onerror="this.style.display='none'">
        <span class="lp-img-icon" style="display:none"></span><span style="display:none"></span>
      </div>
    </div>
  </div>
  </div>{# /tabs-card #}
</div>{# /tabs-section-wrap #}

<!-- ── CAROUSEL ── -->
<div class="carousel-section">
  <div class="carousel-header reveal">
    <h2>WeCare conçu pour votre structure</h2>
    <p>Le logiciel de gestion pour les services à la personne et l'autonomie</p>
  </div>
  <div class="carousel-outer">
    <button class="carousel-btn" id="carousel-prev"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg></button>
    <button class="carousel-btn" id="carousel-next"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg></button>
  <div class="carousel-track-wrap">
    <div class="carousel-track" id="carousel-track">
      {% set carouselCards = [
        {tag:'SAP',           img:'/images/service-daide-a-la-personne.jpg',                                                        title:'Les Services d\'Aides à Domicile',                        sub:'WeCare accompagne les SAAD dans la coordination quotidienne des soins, le suivi des patients et la gestion des interventions.'},
        {tag:'SSIAD',         img:'/images/aide-a-domicile-seniors.jpg',                                                            title:'Pour les Services de Soins Infirmiers à Domicile',        sub:'Vous coordonnez les soins à domicile, WeCare simplifie la coordination de votre équipe et le suivi des patients.'},
        {tag:'SPASAD',        img:'/images/Gemini_Generated_Image_rmbi14rmbi14rmbi.png',                                            title:'Pour les Services Polyvalents d\'Aides et de Soins',      sub:'Coordonnez à la fois l\'aide et les soins à domicile depuis une seule plateforme centralisée.'},
