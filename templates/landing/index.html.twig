<script>
// Tabs
function switchTab(idx, btn) {
  document.querySelectorAll('.tab-pill').forEach((b,i) => b.classList.toggle('active', i === idx));
  document.querySelectorAll('.tab-panel').forEach((p,i) => p.classList.toggle('active', i === idx));
}

// Carousel infini
(function() {
  const track = document.getElementById('carousel-track');
  if (!track) return;

  // Clone toutes les cartes pour la boucle
  const origCards = Array.from(track.children);
  origCards.forEach(c => track.appendChild(c.cloneNode(true)));
  origCards.forEach(c => track.insertBefore(c.cloneNode(true), track.firstChild));

  const total = track.children.length;
  const perPage = origCards.length;
  let idx = perPage; // démarre sur le vrai premier
  let autoTimer;

  function cardW() {
    const c = track.querySelector('.carousel-card');
    return c ? c.offsetWidth + 20 : 320;
  }

  function goTo(i, animated) {
    track.style.transition = animated === false ? 'none' : 'transform 0.5s cubic-bezier(.4,0,.2,1)';
    track.style.transform = `translateX(-${i * cardW()}px)`;
    idx = i;
  }

  track.addEventListener('transitionend', () => {
    if (idx >= perPage * 2) goTo(perPage, false);
    if (idx < perPage)      goTo(perPage * 2 - 1, false);
  });

  function next() { goTo(idx + 1, true); }
  function prev() { goTo(idx - 1, true); }

  document.getElementById('carousel-next')?.addEventListener('click', () => { resetAuto(); next(); });
  document.getElementById('carousel-prev')?.addEventListener('click', () => { resetAuto(); prev(); });

  function startAuto() { autoTimer = setInterval(next, 3500); }
  function resetAuto()  { clearInterval(autoTimer); startAuto(); }

  goTo(idx, false);
  startAuto();
})();

// ── Pricing slider (homepage) ──
const hpTiers = [
  { range: "Jusqu'à 50 bénéficiaires",        monthly: 49,  annual: 539,  economy: 49  },
  { range: 'Entre 51 et 100 bénéficiaires',   monthly: 89,  annual: 979,  economy: 89  },
  { range: 'Entre 101 et 150 bénéficiaires',  monthly: 129, annual: 1419, economy: 129 },
  { range: 'Entre 151 et 200 bénéficiaires',  monthly: 169, annual: 1859, economy: 169 },
  { range: 'Entre 201 et 350 bénéficiaires',  monthly: 209, annual: 2299, economy: 209 },
  { range: 'Entre 351 et 500 bénéficiaires',  monthly: 249, annual: 2739, economy: 249 },
  { range: 'Plus de 500 bénéficiaires',       monthly: 289, annual: 3179, economy: 289 },
];
const hpSlider = document.getElementById('hp-slider');
function hpUpdate() {
  const t = hpTiers[+hpSlider.value];
  const pct = (+hpSlider.value / 6) * 100;
  hpSlider.style.background = `linear-gradient(to right,#41A096 0%,#41A096 ${pct}%,#d4eef8 ${pct}%,#d4eef8 100%)`;
  const hpPriceEl = document.getElementById('hp-price'); if(hpPriceEl) hpPriceEl.textContent = t.monthly + '€';
  document.getElementById('hp-range').textContent         = t.range;
  document.getElementById('hp-annual-range').textContent  = t.range;
  document.getElementById('hp-annual-price').textContent  = t.annual + '€';
  document.getElementById('hp-annual-yearly').textContent = 'Économisez ' + t.economy + '€ par an';
  document.getElementById('hp-monthly-range').textContent = t.range;
  document.getElementById('hp-monthly-price').textContent = t.monthly + '€';
  document.getElementById('hp-monthly-yearly').textContent= 'ou ' + t.annual + '€ / an';

  const isPlus500 = +hpSlider.value === 6;
  document.getElementById('hp-btn-gratuit').style.display = isPlus500 ? 'none'  : 'block';
  document.getElementById('hp-btn-devis').style.display   = isPlus500 ? 'block' : 'none';
}
hpSlider?.addEventListener('input', hpUpdate);
hpUpdate();

// Auto-scroll carousel
if(track) {
  let dir = 1, timer;
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if(e.isIntersecting) timer = setInterval(() => {
        carouselIdx += dir;
        if(carouselIdx >= maxIdx()) dir = -1;
        if(carouselIdx <= 0) dir = 1;
        updateCarousel();
      }, 2500);
      else clearInterval(timer);
    });
  }, {threshold:0.3}).observe(track);
}
</script>
