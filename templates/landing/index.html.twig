<script>
// Tabs
function switchTab(idx, btn) {
  document.querySelectorAll('.tab-pill').forEach((b,i) => b.classList.toggle('active', i === idx));
  document.querySelectorAll('.tab-panel').forEach((p,i) => p.classList.toggle('active', i === idx));
}

// Carousel
const track   = document.getElementById('carousel-track');
const prevBtn = document.getElementById('carousel-prev');
const nextBtn = document.getElementById('carousel-next');
let carouselIdx = 0;

function cardW() { const c = track?.querySelector('.carousel-card'); return c ? c.offsetWidth + 20 : 320; }
function maxIdx(){ return Math.max(0, (track?.children.length || 0) - Math.floor((track?.parentElement.offsetWidth || 900) / cardW())); }
function updateCarousel() { if(track) track.style.transform = `translateX(-${carouselIdx * cardW()}px)`; }

prevBtn?.addEventListener('click', () => { carouselIdx = Math.max(0, carouselIdx-1); updateCarousel(); });
nextBtn?.addEventListener('click', () => { carouselIdx = Math.min(maxIdx(), carouselIdx+1); updateCarousel(); });

// Auto-scroll carousel
if(track) {
  let dir = 1, timer;
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if(e.isIntersecting) timer = setInterval(() => {
        carouselIdx += dir;
        if(carouselIdx >= maxIdx()) dir = -1;
        if(carouselIdx <= 0) dir = 1;
        updateCarousel();
      }, 2500);
      else clearInterval(timer);
    });
  }, {threshold:0.3}).observe(track);
}
</script>
